#!/usr/bin/env php85
<?php

/**
 * TSF 命令行（开发期工具，解释执行）。
 *
 * CLI 本身不需要 AOT —— 它只在开发机上跑，负责生成工程、调用编译器、启停进程。
 * 真正被 AOT 编译的是业务工程（main.php + 各包 src/）。
 *
 * 用法：
 *   tsf new   <name>        新建工程
 *   tsf build [dir]         编译
 *   tsf serve [dir]         编译并启动
 *   tsf watch [dir]         改文件自动重编重启（开发模式）
 *   tsf lint                结构检查（禁 mixed、命名空间与目录一致、核心不依赖 pkg）
 *   tsf config build [dir]  Excel 配置表 → 强类型代码 + 二进制
 *   tsf config check [dir]  只校验配置表
 *   tsf proto build [dir]   .proto → gen/Proto/*.php（消息类 + 编解码）
 *   tsf list                列出可选功能包及启用状态
 *   tsf add/remove <pkg>    启用/移除功能包
 *   tsf version
 */

$tsfRoot = dirname(__DIR__);

// 版本号从 composer.json 读，不在这里维护第二份。
//
// 早先这里是 `const TSF_VERSION = "0.7.0";`，发到 0.9.0 时 cli 还在自报 0.7.0——
// `tsf --version` 与 `composer show` 对不上，排查"装的到底是哪个版本"时很误导。
// 这种"两处各写一遍的常量"迟早会分叉，索性让它只有一个来源。
$__ver = "unknown";
$__raw = @file_get_contents($tsfRoot . "/composer.json");
if ($__raw !== false) {
    $__cj = json_decode($__raw, true);
    if (is_array($__cj) && isset($__cj["version"])) {
        $__ver = (string) $__cj["version"];
    }
}
define("TSF_VERSION", $__ver);

$tpc = getenv("TPC");
if ($tpc === false || $tpc === "") {
    // 探测顺序（用 getenv 而不是 "$HOME/..."——双引号里那是 PHP 变量插值，
    // 未定义变量会变成空串，静默拼成 /typephp-src/...）：
    //   1. ~/.tsf/toolchain/typephp/bin/tpc.php   安装脚本装的位置
    //   2. ~/typephp-src/bin/tpc.php              源码树（开发机）
    $home = getenv("HOME");
    $home = is_string($home) && $home !== "" ? $home : "";
    $installed = $home . "/.tsf/toolchain/typephp/bin/tpc.php";
    if (is_file($installed)) {
        $tpc = $installed;
    } else {
        $tpc = $home . "/typephp-src/bin/tpc.php";
    }
}
$phpBin = getenv("TSF_PHP");
if ($phpBin === false || $phpBin === "") {
    $phpBin = "php85";
}

$argvv = $_SERVER["argv"] ?? [];
$cmd = isset($argvv[1]) ? (string) $argvv[1] : "help";
$arg = isset($argvv[2]) ? (string) $argvv[2] : "";

function c(string $s, string $color): string
{
    $map = ["g" => "32", "y" => "33", "r" => "31", "b" => "36", "d" => "90"];
    $code = $map[$color] ?? "0";
    return "\033[" . $code . "m" . $s . "\033[0m";
}

function say(string $s): void
{
    echo $s . PHP_EOL;
}

function ok(string $s): void
{
    say(c("  OK ", "g") . $s);
}

function warn(string $s): void
{
    say(c("  !  ", "y") . $s);
}

function fail(string $s, int $code = 1): void
{
    say(c("  X  ", "r") . $s);
    exit($code);
}

/** 生成工程的 project.yml（绝对路径，避免相对路径在不同 cwd 下失效） */
/**
 * 读工程清单 project.json（构建用，不是运行期配置）。
 *
 * @return array<string, string|array> name(string) / packages(array)
 */
function readProjectJson(string $projDir): array
{
    $path = $projDir . "/project.json";
    $default = ["name" => basename($projDir), "packages" => []];
    if (!is_file($path)) {
        return $default;
    }
    $d = json_decode((string) file_get_contents($path), true);
    if (!is_array($d)) {
        return $default;
    }
    if (!isset($d["packages"]) || !is_array($d["packages"])) {
        $d["packages"] = [];
    }
    if (!isset($d["name"]) || !is_string($d["name"])) {
        $d["name"] = basename($projDir);
    }
    return $d;
}

/** @param array<string, string|array> $d */
/**
 * 建目录，已存在则跳过。
 *
 * 为什么不用 mkdir(..., true)：在已存在的目录上调它会返回 false 并打 warning，
 * 而 tsf new . 的场景（当前目录已有 composer.json / vendor）正是"目录已存在"。
 */
function ensureDir(string $dir): void
{
    if (!is_dir($dir)) {
        @mkdir($dir, 0777, true);
    }
}

function writeProjectJson(string $projDir, array $d): void
{
    file_put_contents(
        $projDir . "/project.json",
        json_encode($d, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"
    );
}

/**
 * 扫描可用包：每个 pkg/<name>/pkg.json 描述一个包。
 *
 * @return array<string, array<string, string|array>>
 */
function listPackages(string $tsfRoot): array
{
    $out = [];
    $found = glob($tsfRoot . "/pkg/*/pkg.json");
    if ($found === false) {
        return $out;
    }
    foreach ($found as $p) {
        $d = json_decode((string) file_get_contents($p), true);
        if (!is_array($d) || !isset($d["name"]) || !is_string($d["name"])) {
            continue;
        }
        $out[(string) $d["name"]] = $d;
    }
    ksort($out);
    return $out;
}

/**
 * 交互式选包。**只在真终端里问**；CI / 管道 / nohup 直接返回空数组。
 *
 * 为什么要有交互：`tsf new` 出来的工程默认一个可选包都不开，而"要开哪些"
 * 恰恰是建工程时最清楚、最该一次说清的事。等写到一半发现要 db，再去翻
 * project.json 加一行、还要记得依赖（mail 要 db、registry 要 handoff、
 * room 要 fsm+frameloop）——这些都是可以避免的来回。
 *
 * 依赖不用用户操心：project.json 只记"显式启用的"，构建时由 resolvePackages()
 * 补全 requires。所以这里选 room 就只写 room。
 *
 * @return array<int, string>
 */
function promptPackages(string $tsfRoot): array
{
    $all = listPackages($tsfRoot);
    if ($all === []) {
        return [];
    }

    // 非终端不问：`tsf new x < /dev/null`、CI、`| tee` 都会让 fgets 立刻返回 false，
    // 与其读到一个空行"静默不选"，不如明确按"非交互 = 不启用"处理
    $tty = false;
    if (function_exists("stream_isatty")) {
        $tty = stream_isatty(STDIN);
    } elseif (function_exists("posix_isatty")) {
        $tty = posix_isatty(STDIN);
    }
    if (!$tty) {
        return [];
    }

    $names = array_values(array_keys($all));
    $n = count($names);

    say("");
    say("要启用哪些可选功能？（直接回车 = 都不用；以后改 project.json 也能加）");
    say("");
    for ($i = 0; $i < $n; $i++) {
        $name = (string) $names[$i];
        $desc = isset($all[$name]["desc"]) ? (string) $all[$name]["desc"] : "";
        $req = "";
        if (isset($all[$name]["requires"]) && is_array($all[$name]["requires"]) && $all[$name]["requires"] !== []) {
            $req = "  [自动带上 " . implode(",", $all[$name]["requires"]) . "]";
        }
        say("  " . str_pad((string) ($i + 1), 2, " ", STR_PAD_LEFT) . ") "
            . str_pad($name, 11) . $desc . $req);
    }
    say("");
    say("  输入编号（逗号或空格分隔，如 1,5,9），回车跳过 > ");

    $line = fgets(STDIN);
    if (!is_string($line)) {
        return [];
    }
    $line = trim($line);
    if ($line === "") {
        return [];
    }

    $picked = [];
    $tokens = preg_split('/[\s,]+/', $line);
    if (!is_array($tokens)) {
        return [];
    }
    foreach ($tokens as $t) {
        if (!is_string($t) || $t === "" || !ctype_digit($t)) {
            continue;
        }
        $idx = (int) $t - 1;
        if ($idx < 0 || $idx >= $n) {
            continue;   // 越界就忽略，不打断整个流程
        }
        $picked[] = (string) $names[$idx];
    }
    $picked = array_values(array_unique($picked));
    if ($picked !== []) {
        say("  已选: " . implode(", ", $picked));
    }
    return $picked;
}

/**
 * 展开包的依赖闭包，返回按发现顺序排好的包名列表。
 *
 * project.json 只记"用户显式启用的包"，构建时在这里补齐 requires——
 * 手写 project.json 的人不用记得把 entity/frameloop 一起写上。
 *
 * @param array<int, string> $explicit
 * @param array<string, array<string, string|array>> $all
 * @return array<int, string>
 */
function resolvePackages(array $explicit, array $all): array
{
    $out = [];
    $seen = [];
    $queue = [];
    foreach ($explicit as $p) {
        $queue[] = (string) $p;
    }
    while ($queue !== []) {
        $name = (string) array_shift($queue);
        if (isset($seen[$name])) {
            continue;
        }
        $seen[$name] = true;
        if (!isset($all[$name])) {
            throw new \RuntimeException("包 [" . $name . "] 不存在。可用包见 `tsf list`");
        }
        $out[] = $name;
        if (isset($all[$name]["requires"]) && is_array($all[$name]["requires"])) {
            foreach ($all[$name]["requires"] as $dep) {
                $queue[] = (string) $dep;
            }
        }
    }
    return $out;
}

function genProjectYml(string $projDir, string $tsfRoot): string
{
    $src = $projDir . "/src";
    $lines = [];
    $lines[] = "name: " . basename($projDir);
    $lines[] = "version: 0.1.0";
    $lines[] = "cxx-std: c++17";
    $lines[] = "cxx-flags: |";
    $lines[] = "  -O2";
    $lines[] = "sources:";
    $lines[] = "  - " . $tsfRoot . "/src";
    // 原生原语总是参与编译（体积只有几 KB），运行期用 protocol.frame 切换。
    // 这样同一个二进制可以 A/B 对比，也避免"配置改了但类不存在"的编译错误。
    if (is_dir($tsfRoot . "/ext/codec/php-src")) {
        $lines[] = "  - " . $tsfRoot . "/ext/codec/php-src";
        $lines[] = "  - " . $tsfRoot . "/ext/codec/cpp-src";
    }

    // 可选功能包：只编工程声明要用的（含其依赖）。棋牌不需要 AOI，就不该为它付编译时间和体积。
    $proj = readProjectJson($projDir);
    $all = listPackages($tsfRoot);
    foreach (resolvePackages($proj["packages"], $all) as $name) {
        $pdir = $tsfRoot . "/pkg/" . $name . "/src";
        if (is_dir($pdir)) {
            $lines[] = "  - " . $pdir;
        }
        // 带原生部分的包（例如 wasm 桥接）把 PHP 存根和 C++ 分开放：
        // 混进 src/ 会让两边的处理规则互相干扰（.cc 被当 PHP、.php 被当 C++ 都不是第一次了）
        foreach (["php-src", "cpp-src"] as $sub) {
            $sd = $tsfRoot . "/pkg/" . $name . "/" . $sub;
            if (is_dir($sd)) {
                $lines[] = "  - " . $sd;
            }
        }
    }

    if (is_dir($src)) {
        $lines[] = "  - " . $src;
    }
    // 额外源码目录（相对工程目录）。给「bench 要验证 demo 里的业务代码」这类场景用：
    // 复制一份代码去测等于测的是副本，早晚和原件不一致。
    if (isset($proj["sources"]) && is_array($proj["sources"])) {
        foreach ($proj["sources"] as $extra) {
            if (!is_string($extra) || $extra === "") {
                continue;
            }
            $abs = realpath($projDir . "/" . $extra);
            if ($abs === false || !is_dir($abs)) {
                fail("project.json 的 sources 里有不存在的目录: " . $extra);
            }
            $lines[] = "  - " . $abs;
        }
    }
    // 生成的配置表代码（tsf config build 的产物）。
    // 放在独立目录而不是塞进 src/，是为了让"能手改的"和"不能手改的"一眼分开——
    // 同目录下混着两类文件时，总有人去改生成物然后纳闷为什么被覆盖
    if (is_dir($projDir . "/gen")) {
        $lines[] = "  - " . $projDir . "/gen";
    }
    $lines[] = "  - " . $projDir . "/main.php";
    // 链接参数：由工程自己声明。链接哪些库、rpath 指向哪里是「部署形态」决定的，
    // 放进 pkg 没有意义（同一个包在测试机上和在服务器上链的路径不同）。
    // 之前这里不生成 ld-flags，导致「启用 wasm 包」的工程根本链不上 libtp_host——
    // 手写 project.yml 能过，tsf build 就过不了，而且报的是链接错误，很难联想到生成器。
    if (isset($proj["ld-flags"]) && is_array($proj["ld-flags"])) {
        $flags = [];
        foreach ($proj["ld-flags"] as $f) {
            if (is_string($f) && $f !== "") {
                $flags[] = $f;
            }
        }
        if ($flags !== []) {
            $lines[] = "ld-flags: |";
            foreach ($flags as $f) {
                $lines[] = "  " . $f;
            }
        }
    }
    // **每个工程一个构建目录**，不能共用 toolchain 下的全局缓存。
    //
    // 依据（实测报错）：共用的 `.o` 里带着**工程名**符号——
    //   Rpc.o: undefined reference to `typephp_project_shard_test::get_str(unsigned int)`
    // 也就是 `timer-test` 复用了为 `shard-test` 编译的目标文件，链接必然失败。
    // 这就是那些"随机 ld returned 1"的真因：不是并发竞争，是跨工程缓存污染，
    // 谁先编译谁污染，红的是后面那个，所以看起来毫无规律。
    //
    // 代价是每个工程各有一份缓存（首轮冷编译），换来的是"构建结果只取决于本工程"。
    $cacheKey = substr(hash("crc32b", $projDir), 0, 8);
    $home = getenv("HOME");
    $home = is_string($home) && $home !== "" ? $home : "/tmp";
    $lines[] = "build-dir: " . $home . "/.tsf/proj/" . basename($projDir) . "-" . $cacheKey . "/build";
    return implode("\n", $lines) . "\n";
}

function runCmd(string $cmd, string $cwd): int
{
    $old = getcwd();
    if ($old !== false) {
        chdir($cwd);
    }
    $code = 0;
    passthru($cmd, $code);
    if ($old !== false) {
        chdir($old);
    }
    return $code;
}

/**
 * 跑命令并**边输出边收集**，返回 [退出码, 完整输出]。
 *
 * 为什么不用 `exec`：编译有进度条，攒到最后一次性打印等于 11 秒没有任何反馈。
 * 为什么不用 `passthru`：它只回显不收集，判断不了"失败发生在哪个阶段"。
 * proc_open + fgets 两者都要，且逐行 flush 后进度条能正常滚动。
 *
 * @return array{rc:int, out:string}
 */
function runCmdCapture(string $cmd, string $cwd): array
{
    // **不要用 chdir() 传工作目录**：实测（PHP 8.5 ZTS）子进程不会继承父进程
    // php 运行期 chdir 的结果——`chdir(X); proc_open("pwd")` 输出的仍是**原目录**。
    // 之前靠 chdir 的写法在"父进程本来就在目标目录"时碰巧成立（run.sh 都是先 cd 再 build），
    // 一旦从别处调用（比如 `tsf test` 从仓库根遍历）就静默失效：
    // tpc 拿到的 cwd 是仓库根，报 `path not exists: project.yml`，而文件其实好好躺在目标目录里。
    $desc = [1 => ["pipe", "w"], 2 => ["pipe", "w"]];
    $p = $cwd !== "" ? proc_open($cmd, $desc, $pipes, $cwd) : proc_open($cmd, $desc, $pipes);
    if (!is_resource($p)) {
        return ["rc" => 1, "out" => ""];
    }
    // stderr 不读会阻塞子进程，所以先设为非阻塞并在最后一起取
    stream_set_blocking($pipes[1], false);
    stream_set_blocking($pipes[2], false);
    $out = "";
    while (true) {
        $st = proc_get_status($p);
        $chunk = (string) stream_get_contents($pipes[1]);
        if ($chunk !== "") {
            echo $chunk;
            $out .= $chunk;
        }
        $err = (string) stream_get_contents($pipes[2]);
        if ($err !== "") {
            echo $err;
            $out .= $err;
        }
        if (!$st["running"]) {
            break;
        }
        usleep(20000);
    }
    fclose($pipes[1]);
    fclose($pipes[2]);
    $rc = proc_close($p);
    return ["rc" => $rc, "out" => $out];
}

/// 在 PATH 里找一个可执行文件；找不到返回 null。
function findInPath(string $name): ?string
{
    $path = getenv("PATH");
    $dirs = explode(PATH_SEPARATOR, is_string($path) ? $path : "");
    // cargo install 的产物落在 ~/.cargo/bin，默认不在 PATH 里（cargo 本身也不在）。
    // 不兜这一步，wit-bindgen 会被误判成没装——而 preflight 脚本又会判成装了，
    // 两处标准不一致比两边都错更难查。
    $home = getenv("HOME");
    if (is_string($home) && $home !== "") {
        $dirs[] = $home . "/.cargo/bin";
    }
    foreach ($dirs as $dir) {
        if ($dir === "") {
            continue;
        }
        $c = rtrim($dir, "/") . "/" . $name;
        if (is_file($c) && is_executable($c)) {
            return $c;
        }
    }
    return null;
}

/**
 * wasm 模块的发布流水线：编译 → 预编译 → manifest。
 *
 * 之前这四步是手工敲的（tpc 编 wasm、tp-precompile 预编译、拷贝到目标路径、
 * 设 TP_METHODS 重启），漏一步的现象都很隐蔽：
 *   - 少了 tp-precompile（用 wasmtime CLI 代替）→ 所有模块加载失败，句柄 -1000
 *   - 少了工具链检查 → tpc 报 "WASI toolchain check failed"，但不说缺什么
 *
 * 所以这一版把「检查 + 编译 + 预编译 + 记账」串成一条命令，产出可发布的 dist/。
 */
/**
 * 一行检查结果。
 *
 * @param string $level g=通过 y=提示 r=缺失
 */
function docLine(string $level, string $what, string $note): void
{
    $mark = "✓";
    if ($level === "y") {
        $mark = "!";
    } elseif ($level === "r") {
        $mark = "✗";
    }
    echo "  " . c($mark, $level) . " " . str_pad($what, 26) . " " . c($note, "d") . PHP_EOL;
}

/** 在 PATH 里找一个可执行文件，返回绝对路径或空串 */
function docWhich(string $name): string
{
    $path = getenv("PATH");
    if (!is_string($path)) {
        return "";
    }
    foreach (explode(PATH_SEPARATOR, $path) as $dir) {
        if ($dir === "") {
            continue;
        }
        $full = $dir . "/" . $name;
        if (is_file($full) && is_executable($full)) {
            return $full;
        }
    }
    return "";
}

/** 跑 `<bin> --version` 拿版本号（失败返回空串） */
function docVersion(string $bin): string
{
    if (!is_executable($bin)) {
        return "";
    }
    $out = [];
    $rc = 1;
    @exec(escapeshellarg($bin) . " --version 2>/dev/null", $out, $rc);
    if ($rc !== 0 || $out === []) {
        return "";
    }
    // "PHP 8.5.12 (cli) ..." 或 "8.5.12" 两种格式都见过
    $line = trim($out[0]);
    if (preg_match('/(\d+\.\d+\.\d+)/', $line, $m) === 1) {
        return $m[1];
    }
    return "";
}

/** 取主次版本 "8.5" */
function docMinor(string $ver): string
{
    $parts = explode(".", $ver);
    if (count($parts) < 2) {
        return $ver;
    }
    return $parts[0] . "." . $parts[1];
}

/**
 * 环境自检。
 *
 * ## 为什么需要这个命令
 *
 * tsf 不是纯 PHP 框架 —— 它依赖四样 PHP 装不出来的东西：
 *   编译器 tpc、C++ 后端（clang/g++）、特定版本的 PHP（ZTS + swoole + phpx）、
 *   以及（写 wasm 模块时的）WASI 工具链。
 *
 * 缺任何一个，`tsf build` 都只会抛一句很难定位的错（比如
 * "WASI toolchain check failed" 之后你并不知道到底缺什么）。
 * doctor 把这些前置条件在报错**之前**说清楚，并给出修复命令。
 *
 * 退出码：必要项齐全返回 0，缺任何一项返回 1（可直接用在 CI 里）。
 */
/**
 * 列出 tsf 进程的内存占用。
 *
 * 为什么从 /proc 读而不是进程内统计：这是**外部**命令，拿不到别的进程的内存数据。
 * 应用级的（服务数 / 信箱 / 定时器）要看 `Scheduler::stats()`，那个得由服务自己
 * 通过 HTTP 接口吐出来（登录服的 /admin/mem）。
 *
 * 用法：
 *   tsf mem              # 默认找命令行里带 typephp 的进程
 *   tsf mem mygame       # 指定关键字
 */
function cmdMem(string $pattern): int
{
    $pat = $pattern === "" ? "typephp" : $pattern;

    $pids = [];
    @exec("pgrep -f " . escapeshellarg($pat) . " 2>/dev/null", $pids);
    $pids = array_values(array_filter($pids, static fn ($x) => trim($x) !== ""));

    if ($pids === []) {
        say("没找到命令行匹配 [" . $pat . "] 的进程");
        say("试试: tsf mem <你的工程名>");
        return 1;
    }

    printf("%-8s %10s %8s %12s  %s\n", "PID", "RSS", "线程", "运行时长", "命令行");

    foreach ($pids as $pid) {
        $pid = (int) trim($pid);

        // 只看真正的可执行文件：pgrep -f 会匹配到 bash -c "...hi..." 这类命令行，
        // 用 /proc/{pid}/exe 指向的真实路径才能真正区分"这是不是一个 tsf 程序"。
        $exe = @readlink("/proc/" . $pid . "/exe");
        if (!is_string($exe) || $exe === "") {
            continue;
        }
        $base = basename($exe);
        if ($pat !== "" && !str_contains($exe, $pat) && !str_contains($base, $pat)) {
            continue;
        }

        $status = @file_get_contents("/proc/" . $pid . "/status");
        if (!is_string($status)) {
            continue;
        }

        $rssKb = 0;
        $threads = 0;
        foreach (explode("\n", $status) as $line) {
            if (str_starts_with($line, "VmRSS:")) {
                $parts = preg_split('/\s+/', trim($line));
                $rssKb = isset($parts[1]) ? (int) $parts[1] : 0;
            } elseif (str_starts_with($line, "Threads:")) {
                $parts = preg_split('/\s+/', trim($line));
                $threads = isset($parts[1]) ? (int) $parts[1] : 0;
            }
        }

        // 运行时长：进程启动时刻到现在
        $elapsed = "-";
        $stat = @file_get_contents("/proc/" . $pid . "/stat");
        if (is_string($stat)) {
            // 第 22 个字段是 starttime（单位 jiffies）
            $close = strrpos($stat, ")");
            if ($close !== false) {
                $rest = preg_split('/\s+/', trim(substr($stat, $close + 2)));
                $start = isset($rest[19]) ? (int) $rest[19] : 0;
                if ($start > 0) {
                    $uptime = (float) @file_get_contents("/proc/uptime");
                    $elapsed = fmtDuration((int) ($uptime - $start / 100.0));
                }
            }
        }

        $cmd = @file_get_contents("/proc/" . $pid . "/cmdline");
        $cmdStr = is_string($cmd) ? str_replace("\0", " ", trim($cmd)) : "";
        if (strlen($cmdStr) > 60) {
            $cmdStr = substr($cmdStr, 0, 57) . "...";
        }

        printf("%-8d %8.1f MB %8d %12s  %s\n", $pid, $rssKb / 1024.0, $threads, $elapsed, $cmdStr);
    }

    return 0;
}

/** 秒数格式化成 1d2h / 3h4m / 5m6s */
function fmtDuration(int $sec): string
{
    if ($sec < 0) {
        return "-";
    }
    $d = intdiv($sec, 86400);
    $h = intdiv($sec % 86400, 3600);
    $m = intdiv($sec % 3600, 60);
    $s = $sec % 60;
    if ($d > 0) {
        return $d . "d" . $h . "h";
    }
    if ($h > 0) {
        return $h . "h" . $m . "m";
    }
    if ($m > 0) {
        return $m . "m" . $s . "s";
    }
    return $s . "s";
}

function doctor(string $tsfRoot, string $tpc, string $phpBin): int
{
    $need = 0;
    $optional = 0;

    echo PHP_EOL . c("TSF 环境自检", "b") . "   tsf " . TSF_VERSION . PHP_EOL;
    echo str_repeat("-", 62) . PHP_EOL;

    // ---------------- 必要项 ----------------
    echo PHP_EOL . "必要项（缺一个 tsf build 就跑不起来）" . PHP_EOL;

    // 1. PHP 版本 + 线程安全（ZTS）
    //
    // 两个条件缺一不可，而且 **ZTS 不能降级**：phpx 的线程模型建立在 ZTS 上，
    // 编译产物链接的就是 ZTS 版的 libphp。装 8.5 NTS 会通过"版本够"的检查，
    // 但到了编译阶段才以链接错误的形式失败 —— 所以这里必须一起看。
    //
    // 也不要支持 8.2/8.3：CLI 本身确实用不到 8.5 的新语法，但让它跑在旧版本上
    // 会制造"CLI 一个版本、编译链另一个版本"的分裂，排查成本远高于统一要求的收益。
    $verOk = version_compare(PHP_VERSION, "8.5.0", ">=");
    $ztsOk = defined("PHP_ZTS") && PHP_ZTS === true;
    if ($verOk && $ztsOk) {
        docLine("g", "PHP " . PHP_VERSION . " (ZTS)", ">= 8.5 且线程安全");
    } elseif (!$verOk) {
        docLine("r", "PHP " . PHP_VERSION, "需要 >= 8.5" . ($ztsOk ? "（ZTS 已满足）" : "，且必须是 ZTS"));
        $need++;
    } else {
        docLine("r", "PHP " . PHP_VERSION . " (NTS)", "必须是 ZTS 版 —— phpx 依赖线程安全模型");
        echo "      " . c("→ 重装时加 --enable-zts；NTS 版编不出可用的产物", "d") . PHP_EOL;
        $need++;
    }

    // 2. swoole
    if (extension_loaded("swoole")) {
        $v = phpversion("swoole");
        docLine("g", "swoole", (is_string($v) ? $v : "已加载"));
    } else {
        docLine("r", "swoole 扩展", "未加载 —— 编辑产物以它为基础，必须装");
        $need++;
    }

    // 3. phpx 运行时（typephp 编译产物链接的库）
    //
    // 位置**必须从 tpc 推导**，不能写死 `~/typephp-src`：tpc 装在
    // `~/.tsf/toolchain/typephp/bin/` 时，phpx 在它的 `vendor/swoole/phpx/lib/` 下；
    // 只有"源码树直装"才是 `~/typephp-src/...`。写死的结果是官方 Docker 镜像
    // （装的是工具链版）第一次跑 doctor 就红，而 build 其实完全正常。
    $phpxCandidates = [];
    $phpxEnv = getenv("PHPX_LIB");
    if (is_string($phpxEnv) && $phpxEnv !== "") {
        $phpxCandidates[] = $phpxEnv;
    }
    $tpcRoot = dirname(dirname($tpc));
    if ($tpcRoot !== "" && $tpcRoot !== ".") {
        $phpxCandidates[] = $tpcRoot . "/vendor/swoole/phpx/lib/libphpx.so";
    }
    $phpx = "";
    foreach ($phpxCandidates as $cand) {
        if (is_file($cand)) {
            $phpx = $cand;
            break;
        }
    }
    if ($phpx !== "") {
        docLine("g", "phpx 运行时", $phpx);
    } else {
        $hint = $phpxCandidates === [] ? "(无法从 TPC 推导)" : $phpxCandidates[0];
        docLine("r", "phpx 运行时", "缺 " . $hint . " —— 先构建 typephp-src");
        echo "      " . c("→ 按 TPC 位置推导；装在别处时用 PHPX_LIB 指定 .so 全路径", "d") . PHP_EOL;
        $need++;
    }

    // 4. tpc 编译器
    if (is_file($tpc) && is_readable($tpc)) {
        docLine("g", "tpc 编译器", $tpc);
    } else {
        docLine("r", "tpc 编译器", "缺 " . $tpc . " —— 设 TPC 环境变量指向它");
        $need++;
    }

    // 5. 用来跑 tpc 的 PHP（必须是 ZTS + 与目标版本一致）
    $phpPath = docWhich($phpBin);
    if ($phpPath !== "") {
        docLine("g", "编译用 PHP", $phpBin . " → " . $phpPath);
    } else {
        docLine("r", "编译用 PHP", "PATH 里找不到 " . $phpBin . " —— 设 TSF_PHP 或加到 PATH");
        $need++;
    }

    // 6. php-config（tpc 要拿它查头文件和链接参数）
    $phpConfig = "";
    $realBin = "";
    if ($phpPath !== "") {
        // $phpBin 可能是 /usr/local/bin 下的包装脚本，dirname 推出来的 php-config 不存在。
        // 用 PHP_BINDIR 拿真实安装目录（比如 /usr/local/php-8.5-zts/bin）。
        $out = [];
        @exec(escapeshellarg($phpPath) . " -r " . escapeshellarg('echo PHP_BINDIR;') . " 2>/dev/null", $out);
        $realBin = isset($out[0]) ? trim($out[0]) : "";
        if ($realBin !== "") {
            $guess = $realBin . "/php-config";
            if (is_file($guess) && is_executable($guess)) {
                $phpConfig = $guess;
            }
        }
        if ($phpConfig === "") {
            $guess = dirname($phpPath) . "/php-config";
            if (is_file($guess) && is_executable($guess)) {
                $phpConfig = $guess;
            }
        }
    }
    if ($phpConfig === "") {
        $w = docWhich("php-config");
        if ($w !== "") {
            $phpConfig = $w;
        }
    }
    if ($phpConfig === "") {
        docLine("r", "php-config", "找不到 —— 和编译用 PHP 装在同一目录");
        $need++;
    } else {
        // 版本必须和"编译用 PHP"一致。不一致的后果很隐蔽：
        // phpize 生成的 configure 会拿错版本的头文件，编译时报一堆
        // "implicit declaration" / "unknown type name" —— 报错点和真正原因相距很远。
        $cfgVer = docVersion($phpConfig);
        $phpVer = $phpPath !== "" ? docVersion($phpPath) : "";
        if ($cfgVer !== "" && $phpVer !== "" && docMinor($cfgVer) !== docMinor($phpVer)) {
            docLine("r", "php-config", $phpConfig . " 是 " . $cfgVer
                . "，和编译用 PHP " . $phpVer . " 不一致");
            $hint = $realBin !== "" ? ($realBin . "/php-config") : (dirname($phpPath) . "/php-config");
            echo "      " . c("→ 用同版本的 php-config：", "d") . c($hint, "d") . PHP_EOL;
            $need++;
        } else {
            $note = $phpConfig;
            if ($cfgVer !== "") {
                $note = $cfgVer . "  " . $phpConfig;
            }
            docLine("g", "php-config", $note);
        }
    }

    // 7. C++ 编译器
    $cxx = docWhich("clang++");
    if ($cxx === "") {
        $cxx = docWhich("g++");
    }
    if ($cxx !== "") {
        docLine("g", "C++ 编译器", $cxx);
    } else {
        docLine("r", "C++ 编译器", "clang++ / g++ 都没有 —— apt install build-essential");
        $need++;
    }

    // 可选项已移除（wasm 路线废弃，见 docs/research/hot-reload.md）
    $optional = 0;

    // ---------------- 汇总 ----------------
    echo PHP_EOL . str_repeat("-", 62) . PHP_EOL;
    if ($need === 0) {
        echo c("必要项全部通过", "g") . "（PHP " . PHP_VERSION
            . (defined("PHP_ZTS") && PHP_ZTS ? " ZTS" : "") . "），可以 tsf new / tsf build" . PHP_EOL;
        if ($optional > 0) {
            echo c("可选项缺 " . $optional . " 个", "d") . "：不影响必要项" . PHP_EOL;
        }
        return 0;
    }

    echo c("还缺 " . $need . " 个必要项", "r") . "，tsf build 会失败" . PHP_EOL;
    echo PHP_EOL . "修复思路：" . PHP_EOL;
    echo "  1. 装 PHP 8.5（ZTS），带 swoole，并配上 phpx" . PHP_EOL;
    echo "     → 见 docs/guide/00-quickstart.md「环境准备」" . PHP_EOL;
    echo "  2. 构建 typephp-src 拿到 tpc：" . PHP_EOL;
    echo "     cd \$HOME/typephp-src && cmake ... && make" . PHP_EOL;
    echo "  3. 用环境变量覆盖默认路径（不想装在默认位置时）：" . PHP_EOL;
    echo "     export TPC=/path/to/tpc.php" . PHP_EOL;
    echo "     export TSF_PHP=php85" . PHP_EOL;
    return 1;
}



/**
 * 验证套件清单。
 *
 * **只收录确实跑过、且能独立跑起来的**。bench/ 下有二十多个 run*.sh，其中不少是
 * 压测/专项（bot、cluster-bench、probe-*），需要外部条件或跑很久，塞进"一键回归"
 * 只会让人对结果失去信任——一个长期红的套件等于没有套件。
 */
/// 按「显示宽度」补齐：str_pad 按字节算，一个汉字 3 字节会被当成 3 列，
/// 输出到终端就错位了。
function padWidth(string $s, int $width): string
{
    $len = mb_strlen($s, "UTF-8");
    return $s . str_repeat(" ", max(0, $width - $len));
}

