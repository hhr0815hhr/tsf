        ["id" => "coroutine", "desc" => "协程化 Scheduler：让出与恢复", "sh" => "tests/coroutine-test/run.sh"],
        ["id" => "guard", "desc" => "服务守卫：预算/超时/卡死检测", "sh" => "tests/guard-test/run.sh"],
        ["id" => "metrics", "desc" => "埋点/聚合/慢调用打点", "sh" => "tests/metrics-test/run.sh"],
        ["id" => "service", "desc" => "服务生命周期/停机/crash dump", "sh" => "tests/service-test/run.sh"],
        // 时间片与 tick 总预算：出问题时吞吐不变、只在压力下变慢，没有断言盯着等于没有。
        // 三个关键语义：只在消息边界生效 / 打断后不丢消息 / 关掉后行为可逆
        ["id" => "slice", "desc" => "调度时间片 + tick 预算（顺序/不丢/可逆，17 项）", "sh" => "tests/slice-test/run.sh"],
        // 内存归因默认关闭，开着时只写 error 日志——"没报错"和"没生效"在日志里一样，
        // 没有断言就分不清守卫是在工作还是根本没跑
        ["id" => "mem-attr", "desc" => "单服务内存归因：尖峰/配额/kill/清理（15 项）", "sh" => "tests/mem-attr-test/run.sh"],
        ["id" => "discovery", "desc" => "服务发现：注册/失效/收敛", "sh" => "tests/discovery-test/run.sh"],
        ["id" => "entity", "desc" => "实体属性/脏标记/持久化字段", "sh" => "tests/entity-test/run.sh"],
        ["id" => "fsm", "desc" => "状态机转移/守卫/非法转移", "sh" => "tests/fsm-test/run.sh"],
        ["id" => "match", "desc" => "匹配规则/评分/候选筛选", "sh" => "tests/match-test/run.sh"],
        ["id" => "shard", "desc" => "分片路由：环/虚拟节点/再平衡", "sh" => "tests/shard-test/run.sh"],
        ["id" => "shard-router", "desc" => "跨服路由语义：本地/远端/失败", "sh" => "tests/shard-router-test/run.sh"],
        ["id" => "eventlog", "desc" => "追加/重放/坏行修复/截断/多节点归并", "sh" => "tests/eventlog-test/run.sh"],
        ["id" => "checkpoint", "desc" => "事件日志检查点（45 项：截断/等价/水位/增量/坏点被拒）", "sh" => "tests/checkpoint-test/run.sh"],
        ["id" => "schema", "desc" => "状态版本迁移链（19 项：缺 _v/拒绝降级/恢复集成）", "sh" => "tests/snapshot-migrate-test/run.sh"],
        ["id" => "prom", "desc" => "Prometheus 导出（51 项：格式/名字/TYPE/来源限制/运行时指标）", "sh" => "tests/prom-test/run.sh"],
        ["id" => "rpc", "desc" => "RPC（56 项：调用/超时/并发/codec/版本协商/自愈）", "sh" => "tests/rpc-test/run.sh"],
        ["id" => "drain", "desc" => "进程 drain（8 项）", "sh" => "demo/duel/run-drain.sh"],
        ["id" => "rejoin", "desc" => "断线重连（6 项）", "sh" => "demo/duel/run-rejoin.sh"],
        ["id" => "script", "desc" => "脚本热更（加载/对象共享/越权/热更/异常）", "sh" => "tests/script-test/run.sh"],
        ["id" => "http", "desc" => "HTTP 接口（路由/中间件/鉴权/限流）", "sh" => "tests/http-test/run.sh"],
    ];
}

/**
 * 一键回归。
 *
 * 存在意义不是"省几条命令"，而是让「跑没跑过」这件事有唯一答案：
 * 之前验证散在 9 个目录里，各自的入口、前置条件、判定方式都不一样，
 * 新人接手时最贵的成本是"不知道有这些脚本"。
 */
/**
 * 发现式测试：遍历 `tests/` 下所有带 `main.php` 的目录，全部构建并运行。
 *
 * ## 为什么需要它
 *
 * `verify` 只跑**注册过**的套件。仓库里长期存在另一批测试：有 `main.php`、
 * 没有 `run.sh`，因此从没被执行过——它们的断言"一直是绿的"，只是没人跑。
 * 这不是假绿，是**根本没人看**。
 *
 * 这个命令不维护清单：目录里有 `main.php` 就算一个用例，有 `run.sh` 就交给脚本
 * （脚本自己知道要几个进程、几份配置），没有就直接 build + 跑产物。
 *
 * ## 判定
 *
 * - 退出码 0 → PASS
 * - 退出码 77 → SKIP（用例自己声明"缺外部依赖"，和 verify 的约定一致）
 * - 其它 → FAIL，并打印最后几行输出
 *
 * 有外部依赖（MySQL/Postgres/Redis）的用例在这台机器上可能就是红的。
 * **那是信息，不是噪音**：它说明这些东西没有在 CI 里被验证过。
 */
function cmdTest(string $root, string $tsfRoot, string $tpc, string $phpBin, array $argv): int
{
    $filter = "";
    $unwiredOnly = false;
    $one = "";
    $shard = 0;
    $shards = 1;
    $listOnly = false;
    $args = array_slice($argv, 2);
    $n = count($args);
    for ($i = 0; $i < $n; $i++) {
        $a = $args[$i];
        if ($a === "--unwired") {
            $unwiredOnly = true;
            continue;
        }
        if ($a === "--jobs" || $a === "-j" || strpos($a, "--jobs=") === 0) {
            // 并行在本机**不划算**：tpc 每个构建内部已经 -j4，4 核机器上再开多个 worker
            // 只是把 4 核超售成 16 线程（实测 6:56 vs 串行 6:00，CPU 时间反而多 5 分钟）。
            // 真正要扩的是**机器数**，用 --shard 分片到多台 runner / 多个容器。
            fwrite(STDERR, "注意：--jobs 已移除。tpc 内部已 -j4，本机并行只会超售；"
                . "要扩规模请用 --shard i/N 分到多台机器或容器。" . PHP_EOL);
            if ($a === "--jobs" || $a === "-j") {
                $i++;
            }
            continue;
        }
        if ($a === "--list") {
            $listOnly = true;
            continue;
        }
        if ($a === "--shard") {
            // 分片：`--shard 1/3` 表示第 1 片（从 0 开始）。给多机 CI 用——
            // 每台 runner 拿一片，这才是能真正线性扩展的方式
            $spec = isset($args[$i + 1]) ? (string) $args[$i + 1] : "";
            $i++;
            $sp = explode("/", $spec);
            if (count($sp) === 2) {
                $shard = (int) $sp[0];
                $shards = (int) $sp[1] > 0 ? (int) $sp[1] : 1;
            }
            continue;
        }
        if ($a === "--one") {
            // 内部用：父进程并行时按目录各起一个自己，复用全部逻辑（build 的串行重试、
            // skip-auto、run.sh）。不用重写一套"并行版执行器"是这里最重要的取舍
            $one = isset($args[$i + 1]) ? (string) $args[$i + 1] : "";
            $i++;
            continue;
        }
        if ($a !== "" && $a[0] !== "-" && $a !== "test") {
            $filter = $a;
        }
    }

    $dirs = [];
    $raw = glob($root . "/tests/*", GLOB_ONLYDIR);
    if (!is_array($raw)) {
        fail("找不到 tests/ 目录");
    }
    sort($raw);
    foreach ($raw as $d) {
        $dir = (string) $d;
        if (!is_file($dir . "/main.php")) {
            continue;
        }
        if ($one !== "" && $dir !== $one) {
            continue;
        }
        $dirs[] = $dir;
    }

    // --one：子进程模式。只跑一个目录，把结果打一行给父进程解析
    if ($one !== "") {
        if ($dirs === []) {
            echo "RESULT FAIL 0 目录不存在或没有 main.php" . PHP_EOL;
            return 1;
        }
        $r = runOneTest($dirs[0], $tsfRoot, $tpc, $phpBin);
        echo "RESULT " . $r["state"] . " " . $r["ms"] . " " . str_replace(PHP_EOL, " ", $r["tail"]) . PHP_EOL;
        if ($r["state"] === "SKIP") {
            return 77;
        }
        return $r["state"] === "PASS" ? 0 : 1;
    }

    // 过滤（先过滤再决定并行，避免子进程各自重复 glob）
    $picked = [];
    foreach ($dirs as $dir) {
        $id = basename($dir);
        if ($filter !== "" && strpos($id, $filter) === false) {
            continue;
        }
        $hasRun = is_file($dir . "/run.sh");
        if ($unwiredOnly && $hasRun) {
            continue;
        }
        $picked[] = $dir;
    }

    // 分片必须在过滤之后、排序之后做：否则同一片在不同机器上可能对不上
    if ($shards > 1) {
        $slice = [];
        $idx = 0;
        foreach ($picked as $dir) {
            if ($idx % $shards === $shard) {
                $slice[] = $dir;
            }
            $idx++;
        }
        $picked = $slice;
    }

    if ($listOnly) {
        foreach ($picked as $dir) {
            echo basename($dir) . PHP_EOL;
        }
        echo "共 " . count($picked) . " 个" . PHP_EOL;
        return 0;
    }

    $rows = [];
    {
        foreach ($picked as $dir) {
            $id = basename($dir);
            fwrite(STDERR, "→ " . $id . (is_file($dir . "/run.sh") ? "" : "（无 run.sh，直接 build+run）") . " ... ");
            $r = runOneTest($dir, $tsfRoot, $tpc, $phpBin);
            fwrite(STDERR, $r["state"] . PHP_EOL);
            $rows[] = ["id" => $id, "state" => $r["state"], "ms" => $r["ms"], "tail" => $r["tail"], "run" => is_file($dir . "/run.sh")];
        }
    }

    $pass = 0;
    $fail = 0;
    $skip = 0;
    echo PHP_EOL;
    echo padWidth("结果", 6) . padWidth("用例", 20) . padWidth("入口", 10) . "耗时" . PHP_EOL;
    echo str_repeat("-", 64) . PHP_EOL;
    foreach ($rows as $r) {
        if ($r["state"] === "PASS") {
            $pass++;
        } elseif ($r["state"] === "SKIP") {
            $skip++;
        } else {
            $fail++;
        }
        $sec = number_format($r["ms"] / 1000, 1) . "s";
        echo padWidth($r["state"], 6) . padWidth($r["id"], 20)
            . padWidth($r["run"] ? "run.sh" : "main.php", 10) . $sec . PHP_EOL;
        if ($r["tail"] !== "") {
            echo "      ↳ " . $r["tail"] . PHP_EOL;
        }
    }
    echo str_repeat("-", 64) . PHP_EOL;
    echo "通过 " . $pass . " / 失败 " . $fail . " / 跳过 " . $skip . PHP_EOL;

    return $fail === 0 ? 0 : 1;
}

/**
 * 构建期互斥：拿一个全机文件锁再编译。
 *
 * `tpc` 的增量缓存（PCH、object cache）在 `~/.tsf` 下按内容寻址，多进程同时写会撞。
 * 这不是"偶尔慢一点"，是**编译直接失败**——实测 4 路并行 26 个用例红了 20 个，
 * 单独跑全过。所以并行只并行运行，不并行编译。
 *
 * @param \Closure $fn function (): int
 */
function withBuildLock(string $tsfRoot, \Closure $fn): int
{
    $home = getenv("HOME");
    $home = is_string($home) && $home !== "" ? $home : "/tmp";
    $lockPath = $home . "/.tsf/build.lock";
    $dir = dirname($lockPath);
    if (!is_dir($dir)) {
        @mkdir($dir, 0777, true);
    }
    $fh = @fopen($lockPath, "c");
    if (!is_resource($fh)) {
        // 拿不到锁文件也要能跑：退回串行语义（进程内只有我自己）
        return $fn();
    }
    flock($fh, LOCK_EX);
    $rc = $fn();
    flock($fh, LOCK_UN);
    fclose($fh);
    return $rc;
}

/**
 * 跑一个用例目录，返回 {state, ms, tail}。
 *
 * @return array{state: string, ms: int, tail: string}
 */
function runOneTest(string $dir, string $tsfRoot, string $tpc, string $phpBin): array
{
    $hasRun = is_file($dir . "/run.sh");

    // `skip-auto`：用例声明"我依赖外部服务/是交互式探测，别在自动集合里跑"。
    // 用文件而不是代码判断，是为了让"为什么跳过"和用例放在一起、一眼能看到
    $skipFile = $dir . "/skip-auto";
    if (is_file($skipFile)) {
        $why = trim((string) file_get_contents($skipFile));
        return ["state" => "SKIP", "ms" => 0, "tail" => $why === "" ? "声明了 skip-auto" : $why];
    }

    $t0 = microtime(true);
    $out = [];
    if ($hasRun) {
        $rc = 0;
        exec("cd " . escapeshellarg($dir) . " && timeout 300 bash run.sh 2>&1", $out, $rc);
    } else {
        // **构建必须串行**：多个 tpc 同时跑会共用 `~/.tsf` 的 PCH 与增量缓存，
        // 实测 4 路并行时 26 个用例有 20 个报"编译失败"（单独跑全过）。
        // 所以并行的收益只在"运行"阶段，构建用文件锁排队。
        ob_start();
        $rc = withBuildLock($tsfRoot, function () use ($dir, $tsfRoot, $tpc, $phpBin): int {
            return doBuild($dir, $tsfRoot, $tpc, $phpBin);
        });
        $buildOut = (string) ob_get_clean();
        if ($rc === 0) {
            $bin = findBinary($dir);
            if ($bin === "") {
                $out = ["编译成功但找不到产物（目录名与二进制名对不上）"];
                $rc = 1;
            } else {
                exec("cd " . escapeshellarg($dir) . " && timeout 300 " . escapeshellarg($bin) . " 2>&1", $out, $rc);
            }
        } else {
            $lines = array_values(array_filter(explode("\n", $buildOut), function (string $l): bool {
                return trim($l) !== "";
            }));
            $out = $lines === [] ? ["编译失败（没有输出）"] : array_slice($lines, -3);
        }
    }
    $ms = (int) ((microtime(true) - $t0) * 1000);

    /*
     * 光看退出码不够：**大部分测试的 main.php 结尾没有 exit(非零)**，
     * 于是"测试自己报了 FAIL、进程仍然返回 0"，这里就判成 PASS。
     *
     * 这不是假设——db-test 之前就是这样：输出里明明白白两个 FAIL，
     * `tsf test db` 报的是"通过 2 / 失败 0"。**假绿比没有测试更危险**，
     * 因为它会让人相信这块有保护。
     *
     * 所以再解析一遍输出：出现 `FAIL` 行或 `failed=N`（N>0）也判失败。
     */
    $outText = implode("\n", $out);
    /*
     * 只认两种"真失败"的写法，宁可漏也不能误报：
     *   1. 行首的 `FAIL`（各套件的断言行）
     *   2. 行首的 `passed=N failed=M` 汇总行里 M>0
     *
     * 不能直接搜 "failed=[1-9]" —— handoff-test 有个用例把 `failed=1`
     * 当作**数据**打在输出里（验证计数器），那样会把全绿的套件判成失败。
     * 误报的代价是让人开始无视红色，比漏报更糟。
     */
    $outBad = preg_match('/^\s*FAIL\s/m', $outText) === 1
        || preg_match('/^passed=\d+ failed=[1-9][0-9]*$/m', $outText) === 1;
    if ($rc === 0 && $outBad) {
        $rc = 1;
    }

    $state = $rc === 0 ? "PASS" : ($rc === 77 ? "SKIP" : "FAIL");
    $tail = $state === "FAIL" ? implode(" | ", array_slice($out, -3)) : "";
    return ["state" => $state, "ms" => $ms, "tail" => $tail];
}

function verifyRun(string $root, array $argv): int
{
    $suites = verifySuites();

    $only = "";
    $list = false;
    // argv[0] 是脚本路径、argv[1] 是子命令名，都不该参与过滤。
    // 不 slice 的话，裸 `tsf verify` 会把脚本路径当成 only 去匹配套件 id，
    // 结果一个套件都不跑、还报「通过 0 / 失败 0 / 跳过 0」——看着像"全绿"。
    foreach (array_slice($argv, 2) as $a) {
        if ($a === "--list") {
            $list = true;
        } elseif (strpos($a, "--only=") === 0) {
            $only = substr($a, 7);
        } elseif ($a !== "verify" && $a !== "" && $a[0] !== "-") {
            $only = $a;
        }
    }

    if ($list) {
        foreach ($suites as $s) {
            $mark = is_file($root . "/" . $s["sh"]) ? " " : "!";
            echo $mark . " " . padWidth($s["id"], 14) . $s["desc"] . PHP_EOL;
        }
        echo PHP_EOL . "（! 表示脚本不存在）" . PHP_EOL;
        return 0;
    }

    $pass = 0;
    $fail = 0;
    $skip = 0;
    $rows = [];

    foreach ($suites as $s) {
        if ($only !== "" && strpos($s["id"], $only) === false) {
            continue;
        }
        // 依赖外部工具链的套件：缺了就跳过，别让它把整套判成失败。
        // 一个因为环境没配而永远红的套件，会让人学会忽略整个 CI。
        if (isset($s["needs"])) {
            $lack = [];
            foreach ($s["needs"] as $tool) {
                if (findInPath($tool) === null) {
                    $lack[] = $tool;
                }
            }
            if ($lack !== []) {
                $rows[] = ["id" => $s["id"], "desc" => $s["desc"], "state" => "SKIP", "ms" => 0, "tail" => "缺 " . implode(",", $lack)];
                $skip++;
                fwrite(STDERR, "→ " . $s["id"] . " ... SKIP（缺 " . implode(",", $lack) . "）" . PHP_EOL);
                continue;
            }
        }

        $path = $root . "/" . $s["sh"];
        if (!is_file($path)) {
            // demo 是子模块：没跑 git submodule update --init 时这里必然缺
            $why = strpos($s["sh"], "demo/") === 0 ? "demo 子模块未初始化" : "脚本不存在";
            $rows[] = ["id" => $s["id"], "desc" => $s["desc"], "state" => "SKIP", "ms" => 0, "tail" => $why];
            $skip++;
            fwrite(STDERR, "→ " . $s["id"] . " ... SKIP（" . $why . "）" . PHP_EOL);
            continue;
        }

        fwrite(STDERR, "→ " . $s["id"] . " ... ");
        $t0 = microtime(true);
        $out = [];
        $rc = 0;
        exec("bash " . escapeshellarg($path) . " 2>&1", $out, $rc);
        $retried = false;

        // 编译/链接偶发失败：ld 只回 "collect2: error: ld returned 1" 而没有细节，
        // 上一次红的套件每次都不同，单独重跑必过。这种红是噪音——但也不能假装没发生，
        // 所以重试一次并在结果里标出来：真坏了会连续两次失败。
        if ($rc !== 0) {
            $probe = implode(" | ", array_slice($out, -4));
            if (strpos($probe, "编译失败") !== false || strpos($probe, "ld returned") !== false) {
                $out = [];
                $rc = 0;
                exec("bash " . escapeshellarg($path) . " 2>&1", $out, $rc);
                $retried = true;
            }
        }
        $ms = (int) ((microtime(true) - $t0) * 1000);

        // 77 = 脚本主动跳过（端口被占、本机有冲突服务……）。
        // 和 needs 走同一条路：环境问题不该把整套判红，但必须在输出里留下痕迹，
        // 不能让"没跑"看起来像"跑过了"。
        if ($rc === 77) {
            $why = "";
            foreach (array_reverse($out) as $line) {
                if (strpos($line, "SKIP") === 0) {
                    $why = $line;
                    break;
                }
            }
            $rows[] = ["id" => $s["id"], "desc" => $s["desc"], "state" => "SKIP", "ms" => $ms, "tail" => $why];
            $skip++;
            fwrite(STDERR, "SKIP" . PHP_EOL);
            continue;
        }

        $tail = "";
        if ($rc !== 0) {
            $tail = implode(" | ", array_slice($out, -4));
        }
        $state = $rc === 0 ? "PASS" : "FAIL";
        if ($rc === 0) {
            $pass++;
        } else {
            $fail++;
        }
        if ($retried && $state === "PASS") {
            $tail = "首次编译失败，重试通过（疑似 ld 偶发）";
            fwrite(STDERR, "PASS*" . PHP_EOL);
        } else {
            fwrite(STDERR, $state . PHP_EOL);
        }
        $rows[] = ["id" => $s["id"], "desc" => $s["desc"], "state" => $state, "ms" => $ms, "tail" => $tail];
    }

    echo PHP_EOL;
    echo padWidth("结果", 6) . padWidth("套件", 15) . padWidth("内容", 34) . "耗时" . PHP_EOL;
    echo str_repeat("-", 68) . PHP_EOL;
    foreach ($rows as $r) {
        $sec = number_format($r["ms"] / 1000, 1) . "s";
        echo padWidth($r["state"], 6) . padWidth($r["id"], 15) . padWidth($r["desc"], 34) . $sec . PHP_EOL;
        if ($r["tail"] !== "") {
            echo "      ↳ " . $r["tail"] . PHP_EOL;
        }
    }
    echo str_repeat("-", 68) . PHP_EOL;
    echo "通过 " . $pass . " / 失败 " . $fail . " / 跳过 " . $skip . PHP_EOL;

    return $fail === 0 ? 0 : 1;
}


/**
 * 编译失败时的"怎么改"提示。
 *
 * ## 为什么需要这个
 *
 * AOT 的报错和普通 PHP 完全不同：一个在 PHP 里完全合法的写法（同一个变量名先后
 * 装字符串和数组元素），在 AOT 里是编译错误；而错误文本是编译器内部类型名
 * （`php::Str` / `php::Var`），新人看不懂"这跟我写的代码有什么关系"。
 *
 * 实测：我自己一天里被三种错误卡住，每次都要翻附录的 13 条红线才知道怎么改。
 * 如果每次都要翻文档，那"上手成本高"就是必然的。
 *
 * 所以：从输出里**提炼关键错误**（不让人在几十行日志里找），再按已知模式补一条
 * `hint:`。不试图覆盖所有错误——只覆盖那些"看过一次就懂、但第一次必踩"的。
 */

/** @return list<array{0: string, 1: string}> 每项：[匹配用的子串, 提示文本] */
function aotHints(): array
{
    return [
        [
            "Cannot assign value to variable",
            "同一个变量先后承担了两种类型。AOT 在编译期就确定变量的类型，不能像 PHP 那样动态变。\n"
            . "    改法：换个变量名（推荐），或在首次赋值处就保证类型一致。\n"
            . "    典型来源：循环里先 `\$k = \"prefix\" . \$i;`，后面又 `foreach (\$list as \$k)`。",
        ],
        [
            "is undefined in",
            "变量在使用前没有被赋值。AOT 不做「可能未定义」的容忍——它要求控制流上确定有值。\n"
            . "    改法：把赋值提到使用之前；分支里赋值的，给一个初始值。",
        ],
        [
            "is not captured",
            "闭包用了外部变量但没写进 `use (...)`。AOT 比 PHP 严格：漏了就是编译错误而不是运行时 null。\n"
            . "    改法：把变量加进 `use (...)`；需要写的加 `&`。",
        ],
        [
            "Cannot re-assign typed object",
            "同一个变量先后指向了不同类型的对象（比如 if/else 里分别 new A 和 new B）。\n"
            . "    改法：用工厂函数返回统一类型（`ServerFactory::make()` 就是这个用途）。",
        ],
        [
            "must not contain mixed",
            "框架禁止 `mixed` 类型声明（见指南 08）。AOT 下 mixed 会让所有下游推断失效。\n"
            . "    改法：用联合类型（`string|array|object`）或明确的接口类型。",
        ],
        [
            "undefined reference to",
            "链接阶段找不到符号。常见原因：用到的扩展（如 ext/interp、ext/codec）没有参与编译。\n"
            . "    改法：检查 project.yml 的 `ext:` 段；必要时删掉 build-dir 重编。",
        ],
        [
            "All execution code must be within a function",
            "AOT 不允许顶层执行代码（普通 PHP 可以）。\n"
            . "    改法：把逻辑放进函数/`main()`，由框架的入口约定调用，不要在文件顶层直接写语句。",
        ],
        [
            "project.yml",
            "找不到 project.yml。通常是工作目录不对（从仓库根调用子工程）。\n"
            . "    改法：`tsf build <工程目录>`，不要在父目录直接跑。",
        ],
    ];
}

/**
 * 提炼失败输出里最关键的几行，并附上修法。
 *
 * 只挑 `Fatal error` / `error:` 开头的行：tpc 的其余输出是进度和缓存命中信息，
 * 混在一起会把真正的错误埋掉（实测一次失败能刷 30+ 行）。
 */
function explainBuildFailure(string $out): void
{
    $key = [];
    foreach (explode("\n", $out) as $line) {
        $t = trim($line);
        if ($t === "") {
            continue;
        }
        if (stripos($t, "Fatal error:") === 0 || stripos($t, "error:") === 0 || strpos($t, "Compilation failed for:") !== false) {
            $key[] = $t;
        }
    }
    if ($key === []) {
        return;
    }

    say("");
    say(c("  关键错误：", "r"));
    $shown = 0;
    $matched = [];
    foreach ($key as $line) {
        if ($shown >= 5) {
            say(c("  …（还有更多，见上方完整输出）", "d"));
            break;
        }
        say("  " . $line);
        $shown++;
        foreach (aotHints() as $h) {
            if (strpos($line, $h[0]) !== false && !isset($matched[$h[0]])) {
                $matched[$h[0]] = true;
                say("");
                say(c("  hint: ", "y") . $h[1]);
            }
        }
    }
    say("");
    say(c("  类型相关的完整规则：docs/guide/08-aot-types.md", "d"));
}

function doBuild(string $projDir, string $tsfRoot, string $tpc, string $phpBin): int
{
    if (!is_dir($projDir)) {
        fail("工程目录不存在: " . $projDir);
    }
    try {
        $yml = genProjectYml($projDir, $tsfRoot);
    } catch (\RuntimeException $e) {
        fail($e->getMessage());
    }
    file_put_contents($projDir . "/project.yml", $yml);
    $cmd = $phpBin . " " . escapeshellarg($tpc) . " project.yml";
    $r = runCmdCapture($cmd, $projDir);
    if ($r["rc"] === 0) {
        return 0;
    }

    // 只有 **g++ 阶段** 的失败需要重试：并行编译（默认 4 job）会把 g++ 的
    // stderr 吞掉，只留一句 `Compilation failed for: .../main.cc` + Translator 堆栈，
    // 真正的错误（`error: 'server' is not captured`）看不到。
    //
    // 而 PHP→C++ 转换阶段的失败（`Fatal error: The variable $a is undefined ...`）
    // 本来就打得很清楚，重试只会把同样的错误打第二遍，白等一次编译。
    if (strpos($r["out"], "Compilation failed for:") === false) {
        explainBuildFailure($r["out"]);
        return $r["rc"];
    }

    // 串行重试的代价很小：已成功的文件命中增量缓存（会输出 [cached]），
    // 只会真正编译出错的那几个。
    say("");
    say(c("  编译失败。", "y") . "并行模式吞掉了 g++ 的错误，改用串行模式重试以显示真实原因：");
    say(c("  （已成功的文件走增量缓存，只重编出错的）", "d"));
    say("");
    $cmd2 = $phpBin . " " . escapeshellarg($tpc) . " project.yml -j 1";
    $r2 = runCmdCapture($cmd2, $projDir);
    if ($r2["rc"] !== 0) {
        explainBuildFailure($r2["out"]);
    }
    return $r2["rc"];
}

function findBinary(string $projDir): string
{
    $name = basename($projDir);
    $candidates = [
        $projDir . "/" . str_replace("-", "_", $name),
        $projDir . "/" . $name,
    ];
    foreach ($candidates as $c) {
        if (is_file($c) && is_executable($c)) {
            return $c;
        }
    }
    return "";
}

/** 生成的主程序模板 */
/** 从 tsf/tpl 读一个模板；缺文件时返回空串（让调用方暴露问题，而不是生成空文件） */
function tplFile(string $name): string
{
    $path = __DIR__ . "/../tpl/" . $name;
    $s = @file_get_contents($path);
    if (!is_string($s) || $s === "") {
        fwrite(STDERR, "缺少模板文件：" . $path . PHP_EOL);
        return "";
    }
    return $s;
}

/**
 * wasm 模块的 project.yml。
 *
 * wasm-package / wasm-world 从 `pkg/wasm/src/Iface.php` 读 —— 那是唯一来源。
 * 之前模板里写死字符串，一旦上游的 world 名变了，所有工程的 project.yml 都要手工改。
 */



/**
 * 生成登录服工程。
 *
 * 和游戏服的区别：**只有 HTTP，没有帧协议**。所以不生成 client.php、不生成
 * modules/（wasm 热更和登录无关），config 里也没有 protocol 段。
 */
function cmdNewLogin(string $name, string $cwd, string $tsfRoot): int
{
    // 和 case "new" 一样支持 "." （先 composer require 再 tsf new . --login）
    if ($name === "." || $name === "./") {
        $projDir = $cwd;
        if (file_exists($projDir . "/main.php") || file_exists($projDir . "/project.json")) {
            fail("当前目录已经是 tsf 工程（已有 main.php 或 project.json）: " . $projDir);
        }
    } else {
        $projDir = $cwd . "/" . $name;
        if (is_dir($projDir)) {
            fail("目录已存在: " . $projDir);
        }
    }
    ensureDir($projDir . "/config");
    ensureDir($projDir . "/var/log");

    $secret = bin2hex(random_bytes(16));

    $cfg = [
        "app" => ["name" => $name],
        "log" => ["level" => "info", "file" => $projDir . "/var/log/app.log"],
        "login" => [
            "host" => "0.0.0.0",
            "port" => 9101,
            "secret" => $secret,
            // token 有效期（秒）。网关侧不需要知道 ttl，它只验签和过期。
            "token_ttl" => 300,
            // 告诉客户端该连哪个网关（真实项目应该按大区/负载返回不同地址）
            "gateway" => "127.0.0.1:9001",
        ],
    ];
    file_put_contents(
        $projDir . "/config/tsf.json",
        json_encode($cfg, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"
    );

    $body = tplLogin();
    if ($body === "") {
        fail("找不到模板 tpl/login.main.php.txt");
    }
    file_put_contents($projDir . "/main.php", $body);

    // 登录服依赖 pkg/http（路由 + 统一响应）
    writeProjectJson($projDir, ["name" => $name, "packages" => ["http"]]);
    file_put_contents($projDir . "/project.yml", genProjectYml($projDir, $tsfRoot));

    ok("登录服已创建: " . $projDir);
    say("");
    say("下一步：");
    if ($name !== "." && $name !== "./") {
        say("  cd " . $name);
    }
    say("  tsf serve .                       # 编译并启动（默认 9101）");
    say("  curl -X POST -d 'name=alice' \\");
    say("    http://127.0.0.1:9101/login     # 拿 uid + token");
    say("");
    say("把 config/tsf.json 里的 secret 抄到游戏服的 server.auth.secret，");
    say("两边一致网关才会认这个 token。");
    return 0;
}

/** 登录服模板 */
function tplLogin(): string
{
    $f = __DIR__ . "/../tpl/login.main.php.txt";
    $s = @file_get_contents($f);
    return is_string($s) ? $s : "";
}

function tplMain(): string
{
    // 模板独立成文件（tsf/tpl/main.php.txt）：内容有一百多行、含多个顶层函数，
    // 塞进 heredoc 会让 bin/tsf 本身难读，也失去语法高亮。
    // 找不到模板时返回空串 —— 让调用方在写文件时暴露出来，而不是生成一个空 main.php。
    $path = __DIR__ . "/../tpl/main.php.txt";
    $s = @file_get_contents($path);
    if (!is_string($s) || $s === "") {
        fwrite(STDERR, "缺少模板文件：" . $path . PHP_EOL);
        return "";
    }
    return $s;
}

/** 生成的客户端模板；__TSF_ROOT__ 会被替换成框架根目录的绝对路径 */
function tplClient(): string
{
    $php = '<?php

// 最小客户端：用框架同一份帧实现编解码，验证端到端。
// 客户端只需要协议的"契约 + 头实现"三个文件（不需要传输层/Gateway）。
require_once "__TSF_ROOT__/src/Protocol/Contract/DecodedFrame.php";
require_once "__TSF_ROOT__/src/Protocol/Contract/FrameCodec.php";
require_once "__TSF_ROOT__/src/Protocol/Frame/HeaderFrame.php";

use TSF\Protocol\Frame\HeaderFrame;

$port = (int) ($argv[1] ?? 9001);
$token = (string) ($argv[2] ?? "tok-1001");

$sock = stream_socket_client("tcp://127.0.0.1:" . $port, $errno, $errstr, 3);
if ($sock === false) {
    fwrite(STDERR, "connect failed: " . $errstr . PHP_EOL);
    exit(1);
}

/**
 * 读一帧，返回 [msgId, body]；超时返回 null。
 * 缓冲区用 static 保留：一次读到两帧时，第二帧不会丢。
 */
function readFrame($sock, float $timeout = 3.0): ?array
{
    static $buf = "";
    $deadline = microtime(true) + $timeout;
    while (microtime(true) < $deadline) {
        $f = HeaderFrame::parse($buf);
        if ($f !== null) {
            $buf = substr($buf, $f->consumed);
            return [$f->msgId, $f->body];
        }
        $chunk = fread($sock, 65536);
        if ($chunk === false || $chunk === "") {
            if (feof($sock)) {
                return null;
            }
            usleep(1000);
            continue;
        }
        $buf .= $chunk;
    }
    return null;
}

// 1) 登录（默认配置要求鉴权，业务消息必须登录后才能发）
fwrite($sock, HeaderFrame::build(1, $token));          // 1 = MSG_LOGIN
$r = readFrame($sock);
if ($r === null || $r[0] !== 2) {                       // 2 = MSG_LOGIN_OK
    fwrite(STDERR, "login failed: " . var_export($r, true) . PHP_EOL);
    exit(1);
}
echo "login ok uid=" . $r[1] . PHP_EOL;

// 2) echo 往返
$payload = "hello-tsf-" . time();
fwrite($sock, HeaderFrame::build(1001, $payload));      // 1001 = MSG_ECHO_REQ
$r = readFrame($sock);
if ($r === null) {
    fwrite(STDERR, "timeout waiting response" . PHP_EOL);
    fclose($sock);
    exit(1);
}
echo "resp msgId=" . $r[0] . " body=" . $r[1] . PHP_EOL;
echo ($r[1] === $payload ? "OK: echo matched" : "FAIL: body mismatch") . PHP_EOL;
fclose($sock);
exit($r[1] === $payload ? 0 : 1);
';
    return $php;
}

// ---------------- 命令 ----------------

/**
 * 结构约束检查：把"约定"变成可执行的门禁，而不是只写在文档里。
 *
 * 三条规则（对应 README §3 与 §5.8）：
 *   1. 源码里不允许出现 `mixed` 类型声明 —— 用 `string|array|object` 等明确联合类型
 *   2. 命名空间必须与目录路径一致（PSR-4）：TSF\A\B 必须在 src/A/B.php
 *   3. ext/ 下不允许出现 TSF\* 命名空间的类 —— 扩展只提供原生原语
 */
/**
 * @param array<int, string> $problems
 */
function lintTree(string $base, string $nsPrefix, string $root, array &$problems, array &$hints): int
{
    if (!is_dir($base)) {
        return 0;
    }
    $checked = 0;
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($base));
    foreach ($it as $f) {
        if (!$f->isFile() || substr($f->getPathname(), -4) !== ".php") {
            continue;
        }
        $path = $f->getPathname();
        $rel = str_replace($base . "/", "", $path);
        $class = basename($rel, ".php");
        $expected = $nsPrefix . "\\" . str_replace("/", "\\", substr($rel, 0, -4));
        $code = file_get_contents($path);
        $checked++;

        // 规则 2：命名空间与路径一致
        if (preg_match('/^namespace\s+([^;]+);/m', $code, $m)) {
            $ns = trim($m[1]);
            if ($ns . "\\" . $class !== $expected) {
                $problems[] = str_replace($root . "/", "", $path)
                    . "  命名空间是 " . $ns . "，按路径应为 " . substr($expected, 0, -strlen($class) - 1);
            }
        } else {
            $problems[] = str_replace($root . "/", "", $path) . "  缺少 namespace 声明";
        }

        // 规则 1：不允许 mixed 类型声明（跳过注释行）
        $lines = explode("\n", $code);
        foreach ($lines as $i => $line) {
            $t = ltrim($line);
            if ($t === "" || $t[0] === "*" || strncmp($t, "//", 2) === 0 || $t[0] === "#") {
                continue;
            }
            // 去掉行尾注释再判断，避免注释里的示例被误报
            $codePart = $line;
            $posComment = strpos($codePart, "//");
            if ($posComment !== false) {
                $codePart = substr($codePart, 0, $posComment);
            }
            if (preg_match('/(?<![A-Za-z0-9_\\\\])mixed(?![A-Za-z0-9_])/', $codePart)) {
                $problems[] = str_replace($root . "/", "", $path) . ":" . ($i + 1)
                    . "  出现 mixed 类型声明 → " . trim($codePart);
            }

            // 规则 5（提示，不阻塞）：内置文件函数直接吃属性访问
            //
            // 踩过两次的坑：`filemtime($this->path)` 在 AOT 下会被编译成
            // "不传参"的调用，运行到那一行才报
            // `filemtime(): Argument #1 ($filename) not passed`，编译期无告警，
            // 报错信息也完全看不出是编译器的问题。先取局部变量即可。
            //
            // 之所以只是"提示"而不是"错误"：框架自身就有十几处这种写法且运行正常，
            // 说明触发条件比我理解的更窄。把不确定的东西做成阻塞会逼人写 --no-lint。
            if (preg_match('/\b(filemtime|filesize|file_exists|is_file|is_readable|is_dir|file_get_contents|file_put_contents|opcache_invalidate|unlink)\s*\(\s*\$this->[A-Za-z_][A-Za-z0-9_]*\s*[,)]/', $codePart, $m)) {
                $hints[] = str_replace($root . "/", "", $path) . ":" . ($i + 1)
                    . "  " . $m[1] . "() 直接吃属性访问 → AOT 下可能编译成不传参，建议先取局部变量";
            }
        }
    }
    return $checked;
}

/**
 * 业务工程 `scripts/` 的约束（规则 6/7）。
 *
 * 这两条是"热更能不能长期用"的前提，不是洁癖：
 *
 * - **规则 6**：脚本里不能有 `class` / `function` 定义。PHP 不允许重复定义，
 *   `reload()` 第二次必然 `Cannot redeclare`。这个错误在开发期不会暴露
 *   （第一次加载是好的），要等运营点第一次重载才炸。
 * - **规则 7**：脚本只能 `use TSF\Script\*`，能力一律从 `Context` 取。
 *   `12-hot-reload.md` §6.5 那条安全边界——"脚本碰不到任意业务对象"——
 *   只有落成门禁才守得住，否则第一个图省事的人 `use TSF\Room\Room` 就破了。
 *
 * @param array<int, string> $problems
 */
function lintScripts(string $dir, string $root, array &$problems): int
{
    if (!is_dir($dir)) {
        return 0;
    }
    $checked = 0;
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir));
    foreach ($it as $f) {
        if (!$f->isFile() || substr($f->getPathname(), -4) !== ".php") {
            continue;
        }
        $checked++;
        $rel = str_replace($root . "/", "", $f->getPathname());
        $code = (string) file_get_contents($f->getPathname());

        if (preg_match('/^\s*(final\s+|abstract\s+)?class\s+[A-Za-z_]/m', $code)) {
            $problems[] = $rel . "  脚本里不能定义 class（reload 第二次会 Cannot redeclare）";
        }
        if (preg_match('/^\s*function\s+[A-Za-z_]/m', $code)) {
            $problems[] = $rel . "  脚本里不能定义 function（reload 第二次会 Cannot redeclare）";
        }
        if (preg_match_all('/^\s*use\s+(?:function\s+|const\s+)?([^;]+);/m', $code, $m) > 0) {
            foreach ($m[1] as $u) {
                $name = trim($u);
                if (strncmp($name, "TSF\\Script\\", 11) !== 0) {
                    $problems[] = $rel . "  脚本只能 use TSF\\Script\\*，实际 use 了 " . $name;
                }
            }
        }
    }
    return $checked;
}

function cmdLint(string $root, string $project = ""): int
{
    $problems = [];
    $hints = [];
    $checked = 0;

    $pkgs = listPackages($root);

    // 核心
    $checked += lintTree($root . "/src", "TSF", $root, $problems, $hints);

    // 规则 4：核心不得引用可选包（依赖必须单向 src ← pkg）
    //
    // 这条规则的意义不是洁癖。一旦核心 use 了某个 pkg，那个「可选包」就变成事实上的
    // 必需品 —— 关掉它核心编不过。同时意味着核心接受了那个包的业务假设（房间、AOI、
    // 存档……）。可选性靠依赖方向保证，不靠文档承诺。
    $pkgNs = [];
    foreach ($pkgs as $name => $d) {
        $pkgNs[$name] = isset($d["ns"]) ? (string) $d["ns"] : "TSF\\" . ucfirst($name);
    }
    $it4 = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . "/src"));
    foreach ($it4 as $f) {
        if (!$f->isFile() || substr($f->getPathname(), -4) !== ".php") {
            continue;
        }
        $code = (string) file_get_contents($f->getPathname());
        foreach ($pkgNs as $pname => $bad) {
            if (preg_match('/^use\s+' . preg_quote($bad, "/") . '\\\\/m', $code)) {
                $problems[] = str_replace($root . "/", "", $f->getPathname())
                    . "  核心引用了可选包 " . $pname . " → 依赖必须单向（src 不得 use pkg）";
            }
        }
    }

    // 可选功能包：每个包自己声明根命名空间（pkg.json 的 ns 字段）
    foreach ($pkgs as $name => $d) {
        $ns = isset($d["ns"]) ? (string) $d["ns"] : "TSF\\" . ucfirst($name);
        $checked += lintTree($root . "/pkg/" . $name . "/src", $ns, $root, $problems, $hints);
    }

    // 规则 3：ext/ 不出现 TSF 命名空间
    if (is_dir($root . "/ext")) {
        $it2 = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . "/ext"));
        foreach ($it2 as $f) {
            if (!$f->isFile() || substr($f->getPathname(), -4) !== ".php") {
                continue;
            }
            $code = file_get_contents($f->getPathname());
            if (preg_match('/^namespace\s+TSF\\\\/m', $code)) {
                $problems[] = str_replace($root . "/", "", $f->getPathname())
                    . "  ext/ 下不允许 TSF 命名空间的类（适配类应放 src/）";
            }
        }
    }

    // 规则 6/7：业务工程的 scripts/ 约束。只在目标目录有 scripts/ 时生效，
    // 所以 `tsf lint` 不带参数（只查框架）的行为完全不变。
    if ($project !== "" && is_dir($project . "/scripts")) {
        $checked += lintScripts($project . "/scripts", $project, $problems);
    }

    if ($problems === []) {
        ok("结构检查通过：" . $checked . " 个源文件（核心 + " . count($pkgs) . " 个包），"
            . "无 mixed 类型、命名空间与目录一致、核心不依赖可选包");
        // 提示不阻塞：它们指向"AOT 下可能出问题"的写法，但触发条件尚未完全摸清，
        // 做成阻塞会逼人跳过 lint。最多列 8 条，避免刷屏。
        if ($hints !== []) {
            say("");
            say("另有 " . count($hints) . " 条提示（不阻塞，供排查 AOT 怪问题时参考）：");
            $shown = 0;
            foreach ($hints as $h) {
                if ($shown >= 8) {
                    say("  · …… 还有 " . (count($hints) - 8) . " 条");
                    break;
                }
                say("  · " . $h);
                $shown++;
            }
        }

        /*
         * 测试归位：每个有 main.php 的目录，必须有 run.sh（进了 verify）
         * 或者 skip-auto（写明为什么不该进自动集合）。
         *
         * 为什么这条要**阻塞**：§46/§49/§52 三次都是同一个问题——
         * 测试文件好好躺在那里、`tsf verify` 里却没有它，于是从不执行。
         * 「有测试」和「测试在跑」是两件事，而这个差别在踩到之前完全看不出来。
         * 修复成本很低（补个 run.sh 或写一句原因），所以按错误处理。
         */
        $ugated = [];
        // 判据是"在 verifySuites 里"，不是"有 run.sh"——
        // 实测有 4 个目录写着 run.sh 却从没注册（config/gm/proto/watch），
        // 它们和"没 run.sh"一样从不执行，但看起来更完整、更不容易被发现。
        $registered = [];
        foreach (verifySuites() as $vs) {
            $registered[(string) $vs["sh"]] = true;
        }
        // **注意 $root 是 tsf/ 子目录**（cmdLint 的入参），tests 在它的上一级。
        // 第一版这里直接用了 $root，glob 扫的是 tsf/tests/（不存在），
        // 于是这个检查永远通过——又一个"看起来在工作"的空检查。
        $tdirs = glob(dirname($root) . "/tests/*", GLOB_ONLYDIR);
        if (is_array($tdirs)) {
            foreach ($tdirs as $td) {
                $td = (string) $td;
                $name = basename($td);
                if (!is_file($td . "/main.php")) {
                    continue;
                }
                if (is_file($td . "/skip-auto")) {
                    continue;       // 明确声明了为什么不进自动集合
                }
                if (!isset($registered["tests/" . $name . "/run.sh"])) {
                    $ugated[] = $name;
                }
            }
        }
        if ($ugated !== []) {
            say("");
            say(c("  测试没入口：", "r")
                . "以下目录有 main.php，但既没有 run.sh（进 verify）也没有 skip-auto（说明原因）");
            foreach ($ugated as $u) {
                say("    " . $u);
            }
            say(c("  这会变成「测试写了但永远不跑」——补 run.sh 或写 skip-auto", "d"));
            return 1;
        }

        /*
         * 反过来也查一遍：**注册了、脚本却不存在**。
         *
         * 上面那条只查"tests/ 下有 main.php 的目录在不在表里"，不查表里的路径在不在磁盘上。
         * 实测（2026-11-25）：`mail` 这一条指向 tests/mail-test/run.sh，而那个目录只有
         * skip-auto、没有 run.sh。verify 里它显示成 SKIP、永远不红，
         * lint 也永远通过——一张注册表里躺着一个空条目，没人看得出来。
         */
        $ghost = [];
        foreach (verifySuites() as $vs) {
            $sh = (string) $vs["sh"];
            if (strncmp($sh, "tests/", 6) === 0 && !is_file(dirname($root) . "/" . $sh)) {
                $ghost[] = (string) $vs["id"] . " → " . $sh;
            }
        }
        if ($ghost !== []) {
            say("");
            say(c("  注册了不存在的脚本：", "r")
                . "verifySuites() 里这些条目的 run.sh 不在磁盘上，verify 里永远 SKIP、永远不红");
            foreach ($ghost as $g) {
                say("    " . $g);
            }
            say(c("  补脚本，或把条目删掉（目录有 main.php 的话写 skip-auto 说明原因）", "d"));
            return 1;
        }

        /*
         * 再查一条：**run.sh 自己会不会编译**。
         *
         * 实测（2026-11-26）：`gm-test` / `fd-test` / `settle-crash` 三个套件的 run.sh 里没有编译步骤，
         * 直接跑目录里的旧产物——产物停在 11 月 16 日。之后十天里每一次"全量通过"，
         * 这三个套件验证的都是十天前的代码，而输出里它们是绿的。
         * run.sh 的约定是"自己负责 build"（见 README），但没有任何东西检查这一条。
         *
         * 认几种写法：显式 build、走共用入口 scripts/run-svc-test.sh（它内部 build）、
         * `tsf run` / `tsf watch`（它们自己也 build）。
         */
        $noBuild = [];
        foreach (verifySuites() as $vs) {
            $sh = (string) $vs["sh"];
            $full = dirname($root) . "/" . $sh;
            if (!is_file($full)) {
                continue;   // 上一条已经报过了
            }
            $txt = (string) @file_get_contents($full);
            // 去掉注释行：注释里写了"build"不算数
            $code = preg_replace('/^\s*#.*/m', '', $txt);
            if (!is_string($code)) {
                $code = $txt;
            }
            if (strpos($code, "build") === false
                && strpos($code, "run-svc-test.sh") === false
                && strpos($code, " watch ") === false
                && strpos($code, " run ") === false
                // 解释执行的套件（直接 php85 main.php）没有产物，谈不上旧
                && strpos($code, "php85 main.php") === false
            ) {
                $noBuild[] = (string) $vs["id"] . " → " . $sh;
            }
        }
        if ($noBuild !== []) {
            say("");
            say(c("  run.sh 不编译，跑的是目录里的旧产物：", "r")
                . "verify 里它是绿的，但验证的不是当前代码");
            foreach ($noBuild as $g) {
                say("    " . $g);
            }
            say(c("  在 run.sh 里加 `php85 \"\$ROOT/tsf/bin/tsf\" build .`，失败即 exit 1", "d"));
            return 1;
        }

        return 0;
    }

    say("结构检查发现 " . count($problems) . " 处问题：");
    foreach ($problems as $p) {
        say("  ✗ " . $p);
    }
    return 1;
}

/**
 * watch 的轮询间隔（ms）。
 *
 * 200 ms 是"感知上即时"和"别把 CPU 烧在扫描上"的折中。实测全量编译 1.0~1.3 s，
 * 所以轮询间隔根本不是瓶颈——**准不准才是**。
 */
const WATCH_POLL_MS = 200;

/**
 * 监听集合 = `project.yml` 的 sources 列表 + project.json。
 *
 * 为什么不自己写一份"该监听 src/ 和 main.php"：那是**构建输入的副本**，
 * 加了 `gen/`（配置/协议生成物）或新包之后就会漂。直接从 project.yml 读，
 * 永远不会漏——因为编译用的就是这份列表。
 */
function watchSourcePaths(string $projDir): array
{
    $out = [];
    $yml = @file_get_contents($projDir . "/project.yml");
    if ($yml !== false) {
        foreach (explode("\n", $yml) as $line) {
            $t = trim($line);
            if (strncmp($t, "- ", 2) === 0) {
                $p = trim(substr($t, 2));
                if ($p !== "") {
                    $out[] = $p;
                }
            }
        }
    }
    // project.json 决定用哪些包：改它要重编（project.yml 会跟着变，但自己也要在监听范围里）
    $out[] = $projDir . "/project.json";
    return $out;
}

/** @return string[] 递归收集 *.php */
function scanPhpFiles(string $dir): array
{
    $out = [];
    $items = @scandir($dir);
    if ($items === false) {
        return $out;
    }
    foreach ($items as $name) {
        if ($name === "." || $name === "..") {
            continue;
        }
        $p = $dir . "/" . $name;
        if (is_dir($p)) {
            foreach (scanPhpFiles($p) as $f) {
                $out[] = $f;
            }
            continue;
        }
        if (substr($name, -4) === ".php") {
            $out[] = $p;
        }
    }
    return $out;
}

/**
 * 按**内容**算指纹，不看 mtime。
 *
 * `filemtime()` 只到秒：一秒内保存两次、或者改一个等长字符（`1` → `2`），
 * mtime+size 都察觉不到。这个坑 T5-02（服务发现）和 T6-02（配置热更）各踩过一次，
 * 这次直接按内容来。
 *
 * 代价是每轮要读一遍所有源文件。实测约 200 个文件 / 1~2 MB，一轮十几毫秒——
 * 在 200 ms 的轮询间隔下是可接受的，而"漏掉改动"的代价是开发者对着没生效的代码发呆。
 *
 * @return array{0: int, 1: int} [指纹, 文件数]
 */
function watchFingerprint(array $paths): array
{
    $h = 0;
    $n = 0;
    foreach ($paths as $p) {
        if (is_file($p)) {
            $c = @file_get_contents($p);
            $h = crc32($h . "|" . $p . "|" . crc32($c === false ? "" : $c));
            $n++;
            continue;
        }
        if (!is_dir($p)) {
            continue;
        }
        foreach (scanPhpFiles($p) as $f) {
            $c = @file_get_contents($f);
            $h = crc32($h . "|" . $f . "|" . crc32($c === false ? "" : $c));
            $n++;
        }
    }
    return [$h, $n];
}

/** 两段 hrtime 之间的毫秒数 */
function msOf(int $from, int $to): int
{
    return (int) round((float) ($to - $from) / 1000000.0);
}

/** 启动产物，返回进程句柄（同时记到 $GLOBALS，供信号处理器收尸） */
function startChild(string $projDir)
{
    $binPath = findBinary($projDir);
    if ($binPath === "") {
        fail("编译成功但找不到可执行文件");
    }
    $desc = [0 => STDIN, 1 => STDOUT, 2 => STDERR];
    $h = proc_open(escapeshellarg($binPath), $desc, $pipes, $projDir);
    if (!is_resource($h)) {
        fail("启动失败：" . $binPath);
    }
    $GLOBALS["tsf_watch_child"] = $h;
    return $h;
}

/**
 * 先 SIGTERM 再兜底 SIGKILL。
 *
 * 直接 SIGKILL 会跳过服务自己的 `onStop`（日志没刷、注册表没注销、快照没落盘）。
 * 开发期也要给优雅退出留 2 秒——不然调试"退出逻辑对不对"时永远测不出来。
 */
function stopChild($child)
{
    if (!is_resource($child)) {
        return null;
    }
    @proc_terminate($child, 15);
    $deadline = microtime(true) + 2.0;
    while (microtime(true) < $deadline) {
        $st = proc_get_status($child);
        if (!is_array($st) || !isset($st["running"]) || !$st["running"]) {
            break;
        }
        usleep(10000);
    }
    $st = proc_get_status($child);
    if (is_array($st) && isset($st["running"]) && $st["running"]) {
        @proc_terminate($child, 9);
    }
    @proc_close($child);
    $GLOBALS["tsf_watch_child"] = null;
    return null;
}

switch ($cmd) {
    case "version":
        say("TSF " . TSF_VERSION . "  (tpc: " . $tpc . ")");
        break;

    case "lint":
        // 可选位置参数：业务工程目录。给了就同时检查它的 scripts/（规则 6/7）。
        // 不带参数时行为与以前完全一致（只查框架）。
        $lintTarget = "";
        $lintN = count($argvv);
        for ($lintI = 2; $lintI < $lintN; $lintI++) {
            if (strncmp($argvv[$lintI], "--", 2) !== 0) {
                $lintTarget = $argvv[$lintI];
                break;
            }
        }
        if ($lintTarget !== "") {
            $lintTarget = rtrim(str_replace("\\", "/", $lintTarget), "/");
            if ($lintTarget === "") {
                $lintTarget = "/";
            }
        }
        exit(cmdLint($tsfRoot, $lintTarget));
        break;

    case "new":
        // name = 第一个不以 -- 开头的参数。
        //
        // 不能直接拿 $arg（= $argvv[2]）：`tsf new --login` 会把 flag 当成名字，
        // 结果是生成一个叫 "--login" 的目录（实测过）。
        $name = "";
        $argc = count($argvv);
        for ($i = 2; $i < $argc; $i++) {
            if (strncmp($argvv[$i], "--", 2) !== 0) {
                $name = $argvv[$i];
                break;
            }
        }
        if ($name === "") {
            fail("用法: tsf new <name> [--login] [--packages=db,room | --no-packages]\n"
                . "        （名字写 . 表示在当前目录生成）\n"
                . "        不带 --packages/--no-packages 且在终端里运行时，会交互让你选可选功能");
        }
        $isLogin = in_array("--login", $argvv, true);

        // "." / "./"：在当前目录生成。
        //
        // 这是最重要的场景：先 composer require（目录里已经有 composer.json / vendor / lock），
        // 再 tsf new . —— 用 is_dir 判断"已存在"会把当前目录永远判成冲突。
        // 改成检查"关键产物是否已存在"，只拦真正的重复生成。
        $inPlace = ($name === "." || $name === "./");

        if ($isLogin) {
            exit(cmdNewLogin($inPlace ? "." : $name, getcwd(), $tsfRoot));
        }

        if ($inPlace) {
            $projDir = getcwd();
            if (file_exists($projDir . "/main.php") || file_exists($projDir . "/project.json")) {
                fail("当前目录已经是 tsf 工程（已有 main.php 或 project.json）: " . $projDir);
            }
        } else {
            $projDir = getcwd() . "/" . $name;
            if (is_dir($projDir)) {
                fail("目录已存在: " . $projDir);
            }
        }
        ensureDir($projDir . "/config");
        ensureDir($projDir . "/src");
        ensureDir($projDir . "/var/log");


        // 构建清单：声明这个工程要用哪些可选功能包。
        //
        // 三种给法，按优先级：--packages=a,b > --no-packages > 终端交互。
        // 交互只在真终端发生，CI 里不加参数就是"一个都不用"，不会卡住。
        $pickedPackages = [];
        $pkgArg = "";
        $noPkg = false;
        foreach ($argvv as $a) {
            if (strpos($a, "--packages=") === 0) {
                $pkgArg = substr($a, strlen("--packages="));
            } elseif ($a === "--no-packages") {
                $noPkg = true;
            }
        }
        if ($pkgArg !== "") {
            $known = listPackages($tsfRoot);
            foreach (explode(",", $pkgArg) as $one) {
                $one = trim($one);
                if ($one === "") {
                    continue;
                }
                if (!isset($known[$one])) {
                    fail("未知的包 [" . $one . "]，可用包见 `tsf list`");
                }
                $pickedPackages[] = $one;
            }
            $pickedPackages = array_values(array_unique($pickedPackages));
        } elseif (!$noPkg) {
            $pickedPackages = promptPackages($tsfRoot);
        }
        writeProjectJson($projDir, ["name" => $arg, "packages" => $pickedPackages]);

        $cfg = [
            "app" => ["name" => $arg],
            "log" => [
                "level" => "info",
                "file" => $projDir . "/var/log/app.log",
            ],
            // 协议：分帧层 + 消息体层，两层独立可换
            "protocol" => [
                // frame:   native（C++，推荐）| header（纯 PHP，排障用）
                "frame" => "native",
                // payload: raw（透传）| json | msgpack | protobuf | registry
                "payload" => "raw",
            ],
            "server" => [
                "host" => "0.0.0.0",
                "port" => 9001,
                // tcp | ws（WebSocket；payload 仍是同一套二进制帧）
                "transport" => "tcp",
                "worker_num" => 1,
                "max_conn" => 10000,
                "nodelay" => true,
                // 心跳：服务端超过这么多秒没收到任何帧就断开
                "heartbeat_sec" => 30,
                // 限流：每秒补充 rate_per_sec 个令牌，桶容量 rate_burst
                "rate_per_sec" => 50,
                "rate_burst" => 100,
                // 未登录流量**按来源 IP** 的限流（同一来源的未登录连接共用一个桶，重连拿不到新桶）。
                // 不配 = 和上面同档；配 0 关闭
                // "peer_rate_per_sec": 50,
                // "peer_rate_burst": 100,
                // 连上之后这么久还没登录就断开（未登录的连接可以一直发心跳躲开空闲清扫）。0 = 关闭
                "login_timeout_sec" => 30,
                // 登录失败处置：同一连接连续 5 次 → 断开；同一来源 60 秒内 10 次 → 封 600 秒
                "login_fail_per_conn" => 5,
                "login_fail_per_ip" => 10,
                "login_fail_window_sec" => 60,
                "login_ban_sec" => 600,
                "auth" => [
                    // require=false 仅用于压测/内网；生产必须为 true
                    "require" => true,
                    // 是否接受永不过期的 2 段旧格式 token。生产环境应当 false
                    "allow_legacy" => true,
                    "secret" => "dev-secret-change-me",
                    "tokens" => [
                        "tok-1001" => 1001,
                        "tok-1002" => 1002,
                    ],
                ],
            ],
        ];
        file_put_contents(
            $projDir . "/config/tsf.json",
            json_encode($cfg, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"
        );

        file_put_contents($projDir . "/main.php", tplMain());

        $client = str_replace("__TSF_ROOT__", $tsfRoot, tplClient());
        file_put_contents($projDir . "/client.php", $client);

        file_put_contents($projDir . "/project.yml", genProjectYml($projDir, $tsfRoot));

        ok("工程已创建: " . $projDir);
        say("");
        say("下一步：");
        if (!$inPlace) {
            say("  cd " . $name);
        }
        say("  tsf serve .            # 编译并启动");
        say("  php85 client.php       # 另开终端验证 echo");
        break;

    case "list":
        $all = listPackages($tsfRoot);
        $explicit = [];
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir !== false) {
            $proj = readProjectJson($projDir);
            foreach ($proj["packages"] as $p) {
                $explicit[(string) $p] = true;
            }
        }
        $resolved = [];
        if ($explicit !== []) {
            try {
                foreach (resolvePackages(array_keys($explicit), $all) as $n) {
                    $resolved[$n] = true;
                }
            } catch (\RuntimeException $e) {
                say("  ! " . $e->getMessage());
            }
        }

        say("可选功能包（tsf/pkg/）：");
        if ($all === []) {
            say("  （无）");
            break;
        }
        foreach ($all as $name => $d) {
            if (isset($explicit[$name])) {
                $mark = "[x]";
            } elseif (isset($resolved[$name])) {
                $mark = "[+]"; // 依赖被带上，不是显式启用
            } else {
                $mark = "[ ]";
            }
            $desc = isset($d["desc"]) ? (string) $d["desc"] : "";
            $req = "";
            if (isset($d["requires"]) && is_array($d["requires"]) && $d["requires"] !== []) {
                $req = "  依赖: " . implode(",", $d["requires"]);
            }
            say("  " . $mark . " " . str_pad($name, 10) . $desc . $req);
        }
        say("");
        say("  [x] 显式启用   [+] 依赖带入   [ ] 未启用");
        break;

    case "add":
    case "remove":
        if ($arg === "") {
            fail("用法: tsf " . $cmd . " <package>");
        }
        $projDir = getcwd();
        // 必须有 project.json 才动手。早先直接按 cwd 写，在工程父目录执行时
        // 会新建一个空的 project.json 并"成功"提示已启用 —— 而真正的工程
        // 配置一点没变，下次 build 依然没编进那个包，排查时完全想不到是这一步。
        if (!is_file($projDir . "/project.json")) {
            fail(
                "当前目录没有 project.json，不能在" . "这里改包集合。" . PHP_EOL
                . "  当前目录: " . $projDir . PHP_EOL
                . "  请 cd 到工程目录再执行（含 main.php 与 project.json 的那一层）"
            );
        }
        $all = listPackages($tsfRoot);
        if (!isset($all[$arg])) {
            fail("没有这个包: " . $arg . "（用 tsf list 查看可用包）");
        }
        $proj = readProjectJson($projDir);
        $pkgs = [];
        foreach ($proj["packages"] as $p) {
            $pkgs[] = (string) $p;
        }
        if ($cmd === "add") {
            // 只记显式启用的包；依赖在构建时由 resolvePackages 展开
            if (!in_array($arg, $pkgs, true)) {
                $pkgs[] = $arg;
            }
        } else {
            $kept = [];
            foreach ($pkgs as $p) {
                if ($p !== $arg) {
                    $kept[] = $p;
                }
            }
            $pkgs = $kept;
        }
        $proj["packages"] = $pkgs;
        writeProjectJson($projDir, $proj);
        ok(($cmd === "add" ? "已启用 " : "已移除 ") . $arg . "；当前显式启用: [" . implode(", ", $pkgs) . "]");
        try {
            $res = resolvePackages($pkgs, $all);
            say("构建时的实际包集合: [" . implode(", ", $res) . "]");
        } catch (\RuntimeException $e) {
            say("  ! " . $e->getMessage());
        }
        say("重新编译后生效: tsf build .");
        break;

    case "config":
        // 配置表工具链只在开发机跑（解释执行），不进 AOT 产物。
        // 所以它可以用 ZipArchive/SimpleXML 读 Excel，而运行期只用 tsf/src/Config/Reader
        $toolDir = $tsfRoot . "/tools/config";
        require_once $toolDir . "/Bin.php";
        require_once $toolDir . "/Field.php";
        require_once $toolDir . "/Xlsx.php";
        require_once $toolDir . "/Exporter.php";

        $sub = $arg;
        $dirArg = isset($argvv[3]) ? (string) $argvv[3] : ".";
        if ($sub !== "build" && $sub !== "check") {
            say("用法: tsf config build|check [工程目录]");
            say("  build  Excel → gen/Config/*.php + build/config/*.bin");
            say("  check  只校验，不写产物");
            exit(2);
        }
        $projDir = realpath($dirArg);
        if ($projDir === false) {
            fail("目录不存在: " . $dirArg);
        }
        $exporter = new \TSF\Tool\Config\Exporter($projDir);
        $rc = $exporter->run($sub === "build");
        if ($rc === 0 && $sub === "build") {
            ok("配置表已导出到 " . $projDir . "/build/config");
        }
        exit($rc);

    case "proto":
        // 协议生成：只在开发机跑，产物是 gen/Proto/*.php（会被编进二进制）
        $toolDir = $tsfRoot . "/tools/proto";
        require_once $toolDir . "/Parser.php";
        require_once $toolDir . "/Generator.php";

        $sub = $arg;
        $dirArg = isset($argvv[3]) ? (string) $argvv[3] : ".";
        if ($sub !== "build") {
            say("用法: tsf proto build [工程目录]");
            say("  读 <工程>/proto/*.proto（proto3 子集），生成 <工程>/gen/Proto/*.php");
            exit(2);
        }
        $projDir = realpath($dirArg);
        if ($projDir === false) {
            fail("目录不存在: " . $dirArg);
        }
        $files = glob($projDir . "/proto/*.proto");
        if ($files === false || $files === []) {
            fail("没有 .proto 文件：" . $projDir . "/proto/");
        }
        sort($files);

        $messages = [];
        $enums = [];
        $errors = [];
        foreach ($files as $file) {
            $src = (string) file_get_contents($file);
            $p = new \TSF\Tool\Proto\Parser($file);
            $r = $p->parse($src);
            foreach ($r["errors"] as $e) {
                $errors[] = $e;
            }
            foreach ($r["messages"] as $m) {
                $messages[] = $m;
            }
            foreach ($r["enums"] as $e) {
                $enums[] = $e;
            }
        }
        // 注意：这里**不能**因为解析出错就退出——语义校验还要跑（未知类型、协议号冲突…），
        // 否则用户得改一轮跑一轮。合并见下面
        $gen = new \TSF\Tool\Proto\Generator([
            "messages" => $messages,
            "enums" => $enums,
            "errors" => [],
        ]);
        // 解析出错也要往下跑语义校验：否则用户得先修语法、再跑一次才看到类型错误，
        // 改一轮跑一轮。这里把两阶段的问题合并成一张清单
        $gen->validate();
        $all = $errors;
        foreach ($gen->errors() as $e) {
            $all[] = $e;
        }
        if ($all !== []) {
            say("  ✗ 发现 " . count($all) . " 处问题，未生成任何文件：");
            foreach ($all as $e) {
                say("    " . $e);
            }
            exit(1);
        }

        $code = $gen->generate();

        $outDir = $projDir . "/gen/Proto";
        if (!is_dir($outDir) && !mkdir($outDir, 0777, true) && !is_dir($outDir)) {
            fail("建不了目录 " . $outDir);
        }
        $bytes = 0;
        foreach ($code as $name => $content) {
            file_put_contents($outDir . "/" . $name, $content);
            $bytes += strlen($content);
        }
        ok("生成 " . count($code) . " 个文件（" . count($messages) . " 个消息 / "
            . count($enums) . " 个枚举，" . round($bytes / 1024) . " KB）→ gen/Proto/");
        foreach ($messages as $m) {
            say("      " . $m["name"] . "  id=" . $m["id"] . "  字段 " . count($m["fields"]));
        }
        exit(0);

    case "build":
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }
        $code = doBuild($projDir, $tsfRoot, $tpc, $phpBin);
        if ($code !== 0) {
            fail("编译失败（exit " . $code . "）");
        }
        $binPath = findBinary($projDir);
        if ($binPath === "") {
            fail("编译成功但找不到可执行文件");
        }
        ok("产物: " . $binPath . "  (" . round(filesize($binPath) / 1024) . " KB)");
        break;

    case "migrate":
        // 部署步骤：跑一次就退出。**不要**把它塞进 workerStart——
        // 多 worker 会同时 CREATE TABLE，靠记录表只能挡"重复执行"，挡不住并发建表。
        // 生产上可以直接用产物：`./duel migrate`（本项目里就是 tsf migrate 干的事）
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }
        // 守卫：没有 migrations/ 的工程不该走这条路。更重要的是——产物里必须有
        // `migrate` 分支，否则 `./bin migrate` 会被当成"没带参数"直接起服务，
        // 部署脚本就挂在那里等一个永远不返回的迁移
        if (!is_dir($projDir . "/migrations")) {
            fail("这个工程没有 migrations/ 目录，不需要迁移");
        }
        $code = doBuild($projDir, $tsfRoot, $tpc, $phpBin);
        if ($code !== 0) {
            fail("编译失败（exit " . $code . "）");
        }
        $binPath = findBinary($projDir);
        if ($binPath === "") {
            fail("编译成功但找不到可执行文件");
        }
        ok("执行 " . basename($binPath) . " migrate");
        // 双重判定：退出码 + 输出里的失败计数。
        // 只看退出码不够——AOT 产物的 exit(n) 恒为 0（见 Bootstrap::exitWith），
        // 项目里若有人直接写了 exit($code)，迁移失败会被这里当成成功。
        $mr = runCmdCapture(escapeshellarg($binPath) . " migrate", $projDir);
        $migFail = preg_match('/失败\s*[1-9][0-9]*\s*个/u', $mr["out"]) === 1;
        if ($mr["rc"] !== 0 || $migFail) {
            fail("迁移失败（退出码 " . $mr["rc"] . ($migFail ? "，输出里有失败计数" : "") . "）");
        }
        exit(0);
        break;

    case "migrate-status":
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }
        if (!is_dir($projDir . "/migrations")) {
            fail("这个工程没有 migrations/ 目录");
        }
        $binPath = findBinary($projDir);
        if ($binPath === "") {
            fail("还没编译过：先跑 tsf build");
        }
        $rc = runCmd(escapeshellarg($binPath) . " migrate-status", $projDir);
        exit($rc);
        break;

    case "test":
        $root = dirname(__DIR__, 2);
        exit(cmdTest($root, $tsfRoot, $tpc, $phpBin, $argv));

    case "verify":
        $root = dirname(__DIR__, 2);
        exit(verifyRun($root, $argv));

    case "mem":
        exit(cmdMem($arg));

    case "doctor":
        exit(doctor($tsfRoot, $tpc, $phpBin));

    case "serve":
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }
        $code = doBuild($projDir, $tsfRoot, $tpc, $phpBin);
        if ($code !== 0) {
            fail("编译失败（exit " . $code . "）");
        }
        $binPath = findBinary($projDir);
        if ($binPath === "") {
            fail("找不到可执行文件");
        }
        ok("启动 " . basename($binPath) . "（Ctrl+C 结束）");
        runCmd(escapeshellarg($binPath), $projDir);
        break;

    case "watch":
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }

        say(c("首次编译…", "b"));
        if (doBuild($projDir, $tsfRoot, $tpc, $phpBin) !== 0) {
            fail("首次编译失败，先修好再 watch（否则后面每改一次都失败）");
        }

        // 监听集合直接**从 project.yml 读**：那就是构建输入本身。
        // 自己另写一份"该监听哪些目录"一定会漂——加了 gen/ 或新包，watch 不知道
        $paths = watchSourcePaths($projDir);
        $child = startChild($projDir);
        $last = watchFingerprint($paths);
        ok("watch 就绪：" . $last[1] . " 个文件，轮询 " . WATCH_POLL_MS . "ms，Ctrl+C 退出");
        say(c("  监听：" . implode(" ", $paths), "d"));

        // Ctrl+C 要顺手把子进程收掉，否则留一个孤儿进程占着端口，
        // 下次 watch 会莫名其妙启动失败
        if (function_exists("pcntl_async_signals")) {
            pcntl_async_signals(true);
            $bye = function (): void {
                $c = $GLOBALS["tsf_watch_child"] ?? null;
                if (is_resource($c)) {
                    @proc_terminate($c, 15);
                }
                say("");
                say("watch 退出");
                exit(0);
            };
            pcntl_signal(SIGINT, $bye);
            pcntl_signal(SIGTERM, $bye);
        }

        while (true) {
            usleep(WATCH_POLL_MS * 1000);

            // 产物自己退出了（崩溃 / 正常结束）：报一次，别死循环重启。
            // 自动重启一个一启动就崩的程序只会刷屏，还掩盖真正的错误
            if (is_resource($child)) {
                $st = proc_get_status($child);
                if (is_array($st) && isset($st["running"]) && !$st["running"]) {
                    say(c("[watch] 产物已退出（exit " . (int) $st["exitcode"] . "），等待改动…", "y"));
                    @proc_close($child);
                    $child = null;
                    $GLOBALS["tsf_watch_child"] = null;
                }
            }

            $now = watchFingerprint($paths);
            if ($now[0] === $last[0]) {
                continue;
            }
            // 防抖：编辑器保存往往连着改几个文件（.php + 备份），
            // 立刻编的话会编到一半的状态，还会连编两次。
            // 120 ms 是"够等到第二次写"和"别白等"的折中
            usleep(120000);
            $paths = watchSourcePaths($projDir);
            $now = watchFingerprint($paths);
            $last = $now[0];

            $t0 = hrtime(true);
            $child = stopChild($child);
            $tStop = hrtime(true);
            say(c("[watch] 变更 " . $now[1] . " 个文件，重新编译…", "b"));
            $code = doBuild($projDir, $tsfRoot, $tpc, $phpBin);
            $tBuild = hrtime(true);
            if ($code !== 0) {
                // 编译失败**不重启**：旧进程已经停了，但与其带着旧二进制跑
                // （让人误以为改动生效了），不如让它停着，错误就在上面
                warn("编译失败，已停止；改好会自动重试");
                continue;
            }
            $child = startChild($projDir);
            $ms = (int) round((float) (hrtime(true) - $t0) / 1000000.0);
            ok("已重启（总计 " . $ms . " ms：停 " . msOf($t0, $tStop)
                . " + 编译 " . msOf($tStop, $tBuild)
                . " + 启动 " . msOf($tBuild, hrtime(true)) . "）");
        }
        break;

    default:
        say("TSF " . TSF_VERSION);
        say("");
        say("用法:");
        say("  tsf new <name>      新建工程（终端里会交互选可选功能包）");
        say("                      --packages=db,room 指定包 / --no-packages 全不启用");
        say("  tsf build [dir]     编译");
        say("  tsf migrate [dir]   跑数据库迁移（部署时执行一次，跑完退出）");
        say("  tsf migrate-status  只看迁移状态，不写库");
        say("  tsf serve [dir]     编译并启动");
        say("  tsf watch [dir]     开发模式（改动自动重编重启）");
        say("  tsf lint            结构检查（禁 mixed、命名空间一致、核心不依赖 pkg）");
        say("  tsf list            列出可选功能包（pkg/）及当前工程启用了哪些");
        say("  tsf add <pkg>       启用功能包（连带启用其依赖）");
        say("  tsf remove <pkg>    移除功能包");
        say("  tsf version         版本");
        say("");
        say("环境变量: TPC=<tpc.php 路径>  TSF_PHP=<php 可执行文件>");
        break;
}
