#!/usr/bin/env php85
<?php

/**
 * TSF 命令行（开发期工具，解释执行）。
 *
 * CLI 本身不需要 AOT —— 它只在开发机上跑，负责生成工程、调用编译器、启停进程。
 * 真正被 AOT 编译的是业务工程（main.php + 各包 src/）。
 *
 * 用法：
 *   tsf new   <name>        新建工程
 *   tsf build [dir]         编译
 *   tsf serve [dir]         编译并启动
 *   tsf watch [dir]         改文件自动重编重启（开发模式）
 *   tsf lint                结构检查（禁 mixed、命名空间与目录一致、核心不依赖 pkg）
 *   tsf config build [dir]  Excel 配置表 → 强类型代码 + 二进制
 *   tsf config check [dir]  只校验配置表
 *   tsf proto build [dir]   .proto → gen/Proto/*.php（消息类 + 编解码）
 *   tsf list                列出可选功能包及启用状态
 *   tsf add/remove <pkg>    启用/移除功能包
 *   tsf version
 */

$tsfRoot = dirname(__DIR__);

// 版本号从 composer.json 读，不在这里维护第二份。
//
// 早先这里是 `const TSF_VERSION = "0.7.0";`，发到 0.9.0 时 cli 还在自报 0.7.0——
// `tsf --version` 与 `composer show` 对不上，排查"装的到底是哪个版本"时很误导。
// 这种"两处各写一遍的常量"迟早会分叉，索性让它只有一个来源。
$__ver = "unknown";
$__raw = @file_get_contents($tsfRoot . "/composer.json");
if ($__raw !== false) {
    $__cj = json_decode($__raw, true);
    if (is_array($__cj) && isset($__cj["version"])) {
        $__ver = (string) $__cj["version"];
    }
}
define("TSF_VERSION", $__ver);

$tpc = getenv("TPC");
if ($tpc === false || $tpc === "") {
    // 探测顺序（用 getenv 而不是 "$HOME/..."——双引号里那是 PHP 变量插值，
    // 未定义变量会变成空串，静默拼成 /typephp-src/...）：
    //   1. ~/.tsf/toolchain/typephp/bin/tpc.php   安装脚本装的位置
    //   2. ~/typephp-src/bin/tpc.php              源码树（开发机）
    $home = getenv("HOME");
    $home = is_string($home) && $home !== "" ? $home : "";
    $installed = $home . "/.tsf/toolchain/typephp/bin/tpc.php";
    if (is_file($installed)) {
        $tpc = $installed;
    } else {
        $tpc = $home . "/typephp-src/bin/tpc.php";
    }
}
$phpBin = getenv("TSF_PHP");
if ($phpBin === false || $phpBin === "") {
    $phpBin = "php85";
}

$argvv = $_SERVER["argv"] ?? [];
$cmd = isset($argvv[1]) ? (string) $argvv[1] : "help";
$arg = isset($argvv[2]) ? (string) $argvv[2] : "";

function c(string $s, string $color): string
{
    $map = ["g" => "32", "y" => "33", "r" => "31", "b" => "36", "d" => "90"];
    $code = $map[$color] ?? "0";
    return "\033[" . $code . "m" . $s . "\033[0m";
}

function say(string $s): void
{
    echo $s . PHP_EOL;
}

function ok(string $s): void
{
    say(c("  OK ", "g") . $s);
}

function warn(string $s): void
{
    say(c("  !  ", "y") . $s);
}

function fail(string $s, int $code = 1): void
{
    say(c("  X  ", "r") . $s);
    exit($code);
}

/** 生成工程的 project.yml（绝对路径，避免相对路径在不同 cwd 下失效） */
/**
 * 读工程清单 project.json（构建用，不是运行期配置）。
 *
 * @return array<string, string|array> name(string) / packages(array)
 */
function readProjectJson(string $projDir): array
{
    $path = $projDir . "/project.json";
    $default = ["name" => basename($projDir), "packages" => []];
    if (!is_file($path)) {
        return $default;
    }
    $d = json_decode((string) file_get_contents($path), true);
    if (!is_array($d)) {
        return $default;
    }
    if (!isset($d["packages"]) || !is_array($d["packages"])) {
        $d["packages"] = [];
    }
    if (!isset($d["name"]) || !is_string($d["name"])) {
        $d["name"] = basename($projDir);
    }
    return $d;
}

/** @param array<string, string|array> $d */
/**
 * 建目录，已存在则跳过。
 *
 * 为什么不用 mkdir(..., true)：在已存在的目录上调它会返回 false 并打 warning，
 * 而 tsf new . 的场景（当前目录已有 composer.json / vendor）正是"目录已存在"。
 */
function ensureDir(string $dir): void
{
    if (!is_dir($dir)) {
        @mkdir($dir, 0777, true);
    }
}

function writeProjectJson(string $projDir, array $d): void
{
    file_put_contents(
        $projDir . "/project.json",
        json_encode($d, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"
    );
}

/**
 * 扫描可用包：每个 pkg/<name>/pkg.json 描述一个包。
 *
 * @return array<string, array<string, string|array>>
 */
function listPackages(string $tsfRoot): array
{
    $out = [];
    $found = glob($tsfRoot . "/pkg/*/pkg.json");
    if ($found === false) {
        return $out;
    }
    foreach ($found as $p) {
        $d = json_decode((string) file_get_contents($p), true);
        if (!is_array($d) || !isset($d["name"]) || !is_string($d["name"])) {
            continue;
        }
        $out[(string) $d["name"]] = $d;
    }
    ksort($out);
    return $out;
}

/**
 * 展开包的依赖闭包，返回按发现顺序排好的包名列表。
 *
 * project.json 只记"用户显式启用的包"，构建时在这里补齐 requires——
 * 手写 project.json 的人不用记得把 entity/frameloop 一起写上。
 *
 * @param array<int, string> $explicit
 * @param array<string, array<string, string|array>> $all
 * @return array<int, string>
 */
function resolvePackages(array $explicit, array $all): array
{
    $out = [];
    $seen = [];
    $queue = [];
    foreach ($explicit as $p) {
        $queue[] = (string) $p;
    }
    while ($queue !== []) {
        $name = (string) array_shift($queue);
        if (isset($seen[$name])) {
            continue;
        }
        $seen[$name] = true;
        if (!isset($all[$name])) {
            throw new \RuntimeException("包 [" . $name . "] 不存在。可用包见 `tsf list`");
        }
        $out[] = $name;
        if (isset($all[$name]["requires"]) && is_array($all[$name]["requires"])) {
            foreach ($all[$name]["requires"] as $dep) {
                $queue[] = (string) $dep;
            }
        }
    }
    return $out;
}

function genProjectYml(string $projDir, string $tsfRoot): string
{
    $src = $projDir . "/src";
    $lines = [];
    $lines[] = "name: " . basename($projDir);
    $lines[] = "version: 0.1.0";
    $lines[] = "cxx-std: c++17";
    $lines[] = "cxx-flags: |";
    $lines[] = "  -O2";
    $lines[] = "sources:";
    $lines[] = "  - " . $tsfRoot . "/src";
    // 原生原语总是参与编译（体积只有几 KB），运行期用 protocol.frame 切换。
    // 这样同一个二进制可以 A/B 对比，也避免"配置改了但类不存在"的编译错误。
    if (is_dir($tsfRoot . "/ext/codec/php-src")) {
        $lines[] = "  - " . $tsfRoot . "/ext/codec/php-src";
        $lines[] = "  - " . $tsfRoot . "/ext/codec/cpp-src";
    }

    // 可选功能包：只编工程声明要用的（含其依赖）。棋牌不需要 AOI，就不该为它付编译时间和体积。
    $proj = readProjectJson($projDir);
    $all = listPackages($tsfRoot);
    foreach (resolvePackages($proj["packages"], $all) as $name) {
        $pdir = $tsfRoot . "/pkg/" . $name . "/src";
        if (is_dir($pdir)) {
            $lines[] = "  - " . $pdir;
        }
        // 带原生部分的包（例如 wasm 桥接）把 PHP 存根和 C++ 分开放：
        // 混进 src/ 会让两边的处理规则互相干扰（.cc 被当 PHP、.php 被当 C++ 都不是第一次了）
        foreach (["php-src", "cpp-src"] as $sub) {
            $sd = $tsfRoot . "/pkg/" . $name . "/" . $sub;
            if (is_dir($sd)) {
                $lines[] = "  - " . $sd;
            }
        }
    }

    if (is_dir($src)) {
        $lines[] = "  - " . $src;
    }
    // 额外源码目录（相对工程目录）。给「bench 要验证 demo 里的业务代码」这类场景用：
    // 复制一份代码去测等于测的是副本，早晚和原件不一致。
    if (isset($proj["sources"]) && is_array($proj["sources"])) {
        foreach ($proj["sources"] as $extra) {
            if (!is_string($extra) || $extra === "") {
                continue;
            }
            $abs = realpath($projDir . "/" . $extra);
            if ($abs === false || !is_dir($abs)) {
                fail("project.json 的 sources 里有不存在的目录: " . $extra);
            }
            $lines[] = "  - " . $abs;
        }
    }
    // 生成的配置表代码（tsf config build 的产物）。
    // 放在独立目录而不是塞进 src/，是为了让"能手改的"和"不能手改的"一眼分开——
    // 同目录下混着两类文件时，总有人去改生成物然后纳闷为什么被覆盖
    if (is_dir($projDir . "/gen")) {
        $lines[] = "  - " . $projDir . "/gen";
    }
    $lines[] = "  - " . $projDir . "/main.php";
    // 链接参数：由工程自己声明。链接哪些库、rpath 指向哪里是「部署形态」决定的，
    // 放进 pkg 没有意义（同一个包在测试机上和在服务器上链的路径不同）。
    // 之前这里不生成 ld-flags，导致「启用 wasm 包」的工程根本链不上 libtp_host——
    // 手写 project.yml 能过，tsf build 就过不了，而且报的是链接错误，很难联想到生成器。
    if (isset($proj["ld-flags"]) && is_array($proj["ld-flags"])) {
        $flags = [];
        foreach ($proj["ld-flags"] as $f) {
            if (is_string($f) && $f !== "") {
                $flags[] = $f;
            }
        }
        if ($flags !== []) {
            $lines[] = "ld-flags: |";
            foreach ($flags as $f) {
                $lines[] = "  " . $f;
            }
        }
    }
    return implode("\n", $lines) . "\n";
}

function runCmd(string $cmd, string $cwd): int
{
    $old = getcwd();
    if ($old !== false) {
        chdir($cwd);
    }
    $code = 0;
    passthru($cmd, $code);
    if ($old !== false) {
        chdir($old);
    }
    return $code;
}

/**
 * 跑命令并**边输出边收集**，返回 [退出码, 完整输出]。
 *
 * 为什么不用 `exec`：编译有进度条，攒到最后一次性打印等于 11 秒没有任何反馈。
 * 为什么不用 `passthru`：它只回显不收集，判断不了"失败发生在哪个阶段"。
 * proc_open + fgets 两者都要，且逐行 flush 后进度条能正常滚动。
 *
 * @return array{rc:int, out:string}
 */
function runCmdCapture(string $cmd, string $cwd): array
{
    $old = getcwd();
    if ($old !== false) {
        chdir($cwd);
    }
    $desc = [1 => ["pipe", "w"], 2 => ["pipe", "w"]];
    $p = proc_open($cmd, $desc, $pipes);
    if (!is_resource($p)) {
        if ($old !== false) {
            chdir($old);
        }
        return ["rc" => 1, "out" => ""];
    }
    // stderr 不读会阻塞子进程，所以先设为非阻塞并在最后一起取
    stream_set_blocking($pipes[1], false);
    stream_set_blocking($pipes[2], false);
    $out = "";
    while (true) {
        $st = proc_get_status($p);
        $chunk = (string) stream_get_contents($pipes[1]);
        if ($chunk !== "") {
            echo $chunk;
            $out .= $chunk;
        }
        $err = (string) stream_get_contents($pipes[2]);
        if ($err !== "") {
            echo $err;
            $out .= $err;
        }
        if (!$st["running"]) {
            break;
        }
        usleep(20000);
    }
    fclose($pipes[1]);
    fclose($pipes[2]);
    $rc = proc_close($p);
    if ($old !== false) {
        chdir($old);
    }
    return ["rc" => $rc, "out" => $out];
}

/// 在 PATH 里找一个可执行文件；找不到返回 null。
function findInPath(string $name): ?string
{
    $path = getenv("PATH");
    $dirs = explode(PATH_SEPARATOR, is_string($path) ? $path : "");
    // cargo install 的产物落在 ~/.cargo/bin，默认不在 PATH 里（cargo 本身也不在）。
    // 不兜这一步，wit-bindgen 会被误判成没装——而 preflight 脚本又会判成装了，
    // 两处标准不一致比两边都错更难查。
    $home = getenv("HOME");
    if (is_string($home) && $home !== "") {
        $dirs[] = $home . "/.cargo/bin";
    }
    foreach ($dirs as $dir) {
        if ($dir === "") {
            continue;
        }
        $c = rtrim($dir, "/") . "/" . $name;
        if (is_file($c) && is_executable($c)) {
            return $c;
        }
    }
    return null;
}

/**
 * wasm 模块的发布流水线：编译 → 预编译 → manifest。
 *
 * 之前这四步是手工敲的（tpc 编 wasm、tp-precompile 预编译、拷贝到目标路径、
 * 设 TP_METHODS 重启），漏一步的现象都很隐蔽：
 *   - 少了 tp-precompile（用 wasmtime CLI 代替）→ 所有模块加载失败，句柄 -1000
 *   - 少了工具链检查 → tpc 报 "WASI toolchain check failed"，但不说缺什么
 *
 * 所以这一版把「检查 + 编译 + 预编译 + 记账」串成一条命令，产出可发布的 dist/。
 */
/**
 * 一行检查结果。
 *
 * @param string $level g=通过 y=提示 r=缺失
 */
function docLine(string $level, string $what, string $note): void
{
    $mark = "✓";
    if ($level === "y") {
        $mark = "!";
    } elseif ($level === "r") {
        $mark = "✗";
    }
    echo "  " . c($mark, $level) . " " . str_pad($what, 26) . " " . c($note, "d") . PHP_EOL;
}

/** 在 PATH 里找一个可执行文件，返回绝对路径或空串 */
function docWhich(string $name): string
{
    $path = getenv("PATH");
    if (!is_string($path)) {
        return "";
    }
    foreach (explode(PATH_SEPARATOR, $path) as $dir) {
        if ($dir === "") {
            continue;
        }
        $full = $dir . "/" . $name;
        if (is_file($full) && is_executable($full)) {
            return $full;
        }
    }
    return "";
}

/** 跑 `<bin> --version` 拿版本号（失败返回空串） */
function docVersion(string $bin): string
{
    if (!is_executable($bin)) {
        return "";
    }
    $out = [];
    $rc = 1;
    @exec(escapeshellarg($bin) . " --version 2>/dev/null", $out, $rc);
    if ($rc !== 0 || $out === []) {
        return "";
    }
    // "PHP 8.5.12 (cli) ..." 或 "8.5.12" 两种格式都见过
    $line = trim($out[0]);
    if (preg_match('/(\d+\.\d+\.\d+)/', $line, $m) === 1) {
        return $m[1];
    }
    return "";
}

/** 取主次版本 "8.5" */
function docMinor(string $ver): string
{
    $parts = explode(".", $ver);
    if (count($parts) < 2) {
        return $ver;
    }
    return $parts[0] . "." . $parts[1];
}

/**
 * 环境自检。
 *
 * ## 为什么需要这个命令
 *
 * tsf 不是纯 PHP 框架 —— 它依赖四样 PHP 装不出来的东西：
 *   编译器 tpc、C++ 后端（clang/g++）、特定版本的 PHP（ZTS + swoole + phpx）、
 *   以及（写 wasm 模块时的）WASI 工具链。
 *
 * 缺任何一个，`tsf build` 都只会抛一句很难定位的错（比如
 * "WASI toolchain check failed" 之后你并不知道到底缺什么）。
 * doctor 把这些前置条件在报错**之前**说清楚，并给出修复命令。
 *
 * 退出码：必要项齐全返回 0，缺任何一项返回 1（可直接用在 CI 里）。
 */
/**
 * 列出 tsf 进程的内存占用。
 *
 * 为什么从 /proc 读而不是进程内统计：这是**外部**命令，拿不到别的进程的内存数据。
 * 应用级的（服务数 / 信箱 / 定时器）要看 `Scheduler::stats()`，那个得由服务自己
 * 通过 HTTP 接口吐出来（登录服的 /admin/mem）。
 *
 * 用法：
 *   tsf mem              # 默认找命令行里带 typephp 的进程
 *   tsf mem mygame       # 指定关键字
 */
function cmdMem(string $pattern): int
{
    $pat = $pattern === "" ? "typephp" : $pattern;

    $pids = [];
    @exec("pgrep -f " . escapeshellarg($pat) . " 2>/dev/null", $pids);
    $pids = array_values(array_filter($pids, static fn ($x) => trim($x) !== ""));

    if ($pids === []) {
        say("没找到命令行匹配 [" . $pat . "] 的进程");
        say("试试: tsf mem <你的工程名>");
        return 1;
    }

    printf("%-8s %10s %8s %12s  %s\n", "PID", "RSS", "线程", "运行时长", "命令行");

    foreach ($pids as $pid) {
        $pid = (int) trim($pid);

        // 只看真正的可执行文件：pgrep -f 会匹配到 bash -c "...hi..." 这类命令行，
        // 用 /proc/{pid}/exe 指向的真实路径才能真正区分"这是不是一个 tsf 程序"。
        $exe = @readlink("/proc/" . $pid . "/exe");
        if (!is_string($exe) || $exe === "") {
            continue;
        }
        $base = basename($exe);
        if ($pat !== "" && !str_contains($exe, $pat) && !str_contains($base, $pat)) {
            continue;
        }

        $status = @file_get_contents("/proc/" . $pid . "/status");
        if (!is_string($status)) {
            continue;
        }

        $rssKb = 0;
        $threads = 0;
        foreach (explode("\n", $status) as $line) {
            if (str_starts_with($line, "VmRSS:")) {
                $parts = preg_split('/\s+/', trim($line));
                $rssKb = isset($parts[1]) ? (int) $parts[1] : 0;
            } elseif (str_starts_with($line, "Threads:")) {
                $parts = preg_split('/\s+/', trim($line));
                $threads = isset($parts[1]) ? (int) $parts[1] : 0;
            }
        }

        // 运行时长：进程启动时刻到现在
        $elapsed = "-";
        $stat = @file_get_contents("/proc/" . $pid . "/stat");
        if (is_string($stat)) {
            // 第 22 个字段是 starttime（单位 jiffies）
            $close = strrpos($stat, ")");
            if ($close !== false) {
                $rest = preg_split('/\s+/', trim(substr($stat, $close + 2)));
                $start = isset($rest[19]) ? (int) $rest[19] : 0;
                if ($start > 0) {
                    $uptime = (float) @file_get_contents("/proc/uptime");
                    $elapsed = fmtDuration((int) ($uptime - $start / 100.0));
                }
            }
        }

        $cmd = @file_get_contents("/proc/" . $pid . "/cmdline");
        $cmdStr = is_string($cmd) ? str_replace("\0", " ", trim($cmd)) : "";
        if (strlen($cmdStr) > 60) {
            $cmdStr = substr($cmdStr, 0, 57) . "...";
        }

        printf("%-8d %8.1f MB %8d %12s  %s\n", $pid, $rssKb / 1024.0, $threads, $elapsed, $cmdStr);
    }

    return 0;
}

/** 秒数格式化成 1d2h / 3h4m / 5m6s */
function fmtDuration(int $sec): string
{
    if ($sec < 0) {
        return "-";
    }
    $d = intdiv($sec, 86400);
    $h = intdiv($sec % 86400, 3600);
    $m = intdiv($sec % 3600, 60);
    $s = $sec % 60;
    if ($d > 0) {
        return $d . "d" . $h . "h";
    }
    if ($h > 0) {
        return $h . "h" . $m . "m";
    }
    if ($m > 0) {
        return $m . "m" . $s . "s";
    }
    return $s . "s";
}

function doctor(string $tsfRoot, string $tpc, string $phpBin): int
{
    $need = 0;
    $optional = 0;

    echo PHP_EOL . c("TSF 环境自检", "b") . "   tsf " . TSF_VERSION . PHP_EOL;
    echo str_repeat("-", 62) . PHP_EOL;

    // ---------------- 必要项 ----------------
    echo PHP_EOL . "必要项（缺一个 tsf build 就跑不起来）" . PHP_EOL;

    // 1. PHP 版本 + 线程安全（ZTS）
    //
    // 两个条件缺一不可，而且 **ZTS 不能降级**：phpx 的线程模型建立在 ZTS 上，
    // 编译产物链接的就是 ZTS 版的 libphp。装 8.5 NTS 会通过"版本够"的检查，
    // 但到了编译阶段才以链接错误的形式失败 —— 所以这里必须一起看。
    //
    // 也不要支持 8.2/8.3：CLI 本身确实用不到 8.5 的新语法，但让它跑在旧版本上
    // 会制造"CLI 一个版本、编译链另一个版本"的分裂，排查成本远高于统一要求的收益。
    $verOk = version_compare(PHP_VERSION, "8.5.0", ">=");
    $ztsOk = defined("PHP_ZTS") && PHP_ZTS === true;
    if ($verOk && $ztsOk) {
        docLine("g", "PHP " . PHP_VERSION . " (ZTS)", ">= 8.5 且线程安全");
    } elseif (!$verOk) {
        docLine("r", "PHP " . PHP_VERSION, "需要 >= 8.5" . ($ztsOk ? "（ZTS 已满足）" : "，且必须是 ZTS"));
        $need++;
    } else {
        docLine("r", "PHP " . PHP_VERSION . " (NTS)", "必须是 ZTS 版 —— phpx 依赖线程安全模型");
        echo "      " . c("→ 重装时加 --enable-zts；NTS 版编不出可用的产物", "d") . PHP_EOL;
        $need++;
    }

    // 2. swoole
    if (extension_loaded("swoole")) {
        $v = phpversion("swoole");
        docLine("g", "swoole", (is_string($v) ? $v : "已加载"));
    } else {
        docLine("r", "swoole 扩展", "未加载 —— 编辑产物以它为基础，必须装");
        $need++;
    }

    // 3. phpx 运行时（typephp 编译产物链接的库）
    //
    // 位置**必须从 tpc 推导**，不能写死 `~/typephp-src`：tpc 装在
    // `~/.tsf/toolchain/typephp/bin/` 时，phpx 在它的 `vendor/swoole/phpx/lib/` 下；
    // 只有"源码树直装"才是 `~/typephp-src/...`。写死的结果是官方 Docker 镜像
    // （装的是工具链版）第一次跑 doctor 就红，而 build 其实完全正常。
    $phpxCandidates = [];
    $phpxEnv = getenv("PHPX_LIB");
    if (is_string($phpxEnv) && $phpxEnv !== "") {
        $phpxCandidates[] = $phpxEnv;
    }
    $tpcRoot = dirname(dirname($tpc));
    if ($tpcRoot !== "" && $tpcRoot !== ".") {
        $phpxCandidates[] = $tpcRoot . "/vendor/swoole/phpx/lib/libphpx.so";
    }
    $phpx = "";
    foreach ($phpxCandidates as $cand) {
        if (is_file($cand)) {
            $phpx = $cand;
            break;
        }
    }
    if ($phpx !== "") {
        docLine("g", "phpx 运行时", $phpx);
    } else {
        $hint = $phpxCandidates === [] ? "(无法从 TPC 推导)" : $phpxCandidates[0];
        docLine("r", "phpx 运行时", "缺 " . $hint . " —— 先构建 typephp-src");
        echo "      " . c("→ 按 TPC 位置推导；装在别处时用 PHPX_LIB 指定 .so 全路径", "d") . PHP_EOL;
        $need++;
    }

    // 4. tpc 编译器
    if (is_file($tpc) && is_readable($tpc)) {
        docLine("g", "tpc 编译器", $tpc);
    } else {
        docLine("r", "tpc 编译器", "缺 " . $tpc . " —— 设 TPC 环境变量指向它");
        $need++;
    }

    // 5. 用来跑 tpc 的 PHP（必须是 ZTS + 与目标版本一致）
    $phpPath = docWhich($phpBin);
    if ($phpPath !== "") {
        docLine("g", "编译用 PHP", $phpBin . " → " . $phpPath);
    } else {
        docLine("r", "编译用 PHP", "PATH 里找不到 " . $phpBin . " —— 设 TSF_PHP 或加到 PATH");
        $need++;
    }

    // 6. php-config（tpc 要拿它查头文件和链接参数）
    $phpConfig = "";
    $realBin = "";
    if ($phpPath !== "") {
        // $phpBin 可能是 /usr/local/bin 下的包装脚本，dirname 推出来的 php-config 不存在。
        // 用 PHP_BINDIR 拿真实安装目录（比如 /usr/local/php-8.5-zts/bin）。
        $out = [];
        @exec(escapeshellarg($phpPath) . " -r " . escapeshellarg('echo PHP_BINDIR;') . " 2>/dev/null", $out);
        $realBin = isset($out[0]) ? trim($out[0]) : "";
        if ($realBin !== "") {
            $guess = $realBin . "/php-config";
            if (is_file($guess) && is_executable($guess)) {
                $phpConfig = $guess;
            }
        }
        if ($phpConfig === "") {
            $guess = dirname($phpPath) . "/php-config";
            if (is_file($guess) && is_executable($guess)) {
                $phpConfig = $guess;
            }
        }
    }
    if ($phpConfig === "") {
        $w = docWhich("php-config");
        if ($w !== "") {
            $phpConfig = $w;
        }
    }
    if ($phpConfig === "") {
        docLine("r", "php-config", "找不到 —— 和编译用 PHP 装在同一目录");
        $need++;
    } else {
        // 版本必须和"编译用 PHP"一致。不一致的后果很隐蔽：
        // phpize 生成的 configure 会拿错版本的头文件，编译时报一堆
        // "implicit declaration" / "unknown type name" —— 报错点和真正原因相距很远。
        $cfgVer = docVersion($phpConfig);
        $phpVer = $phpPath !== "" ? docVersion($phpPath) : "";
        if ($cfgVer !== "" && $phpVer !== "" && docMinor($cfgVer) !== docMinor($phpVer)) {
            docLine("r", "php-config", $phpConfig . " 是 " . $cfgVer
                . "，和编译用 PHP " . $phpVer . " 不一致");
            $hint = $realBin !== "" ? ($realBin . "/php-config") : (dirname($phpPath) . "/php-config");
            echo "      " . c("→ 用同版本的 php-config：", "d") . c($hint, "d") . PHP_EOL;
            $need++;
        } else {
            $note = $phpConfig;
            if ($cfgVer !== "") {
                $note = $cfgVer . "  " . $phpConfig;
            }
            docLine("g", "php-config", $note);
        }
    }

    // 7. C++ 编译器
    $cxx = docWhich("clang++");
    if ($cxx === "") {
        $cxx = docWhich("g++");
    }
    if ($cxx !== "") {
        docLine("g", "C++ 编译器", $cxx);
    } else {
        docLine("r", "C++ 编译器", "clang++ / g++ 都没有 —— apt install build-essential");
        $need++;
    }

    // 可选项已移除（wasm 路线废弃，见 docs/research/hot-reload.md）
    $optional = 0;

    // ---------------- 汇总 ----------------
    echo PHP_EOL . str_repeat("-", 62) . PHP_EOL;
    if ($need === 0) {
        echo c("必要项全部通过", "g") . "（PHP " . PHP_VERSION
            . (defined("PHP_ZTS") && PHP_ZTS ? " ZTS" : "") . "），可以 tsf new / tsf build" . PHP_EOL;
        if ($optional > 0) {
            echo c("可选项缺 " . $optional . " 个", "d") . "：不影响必要项" . PHP_EOL;
        }
        return 0;
    }

    echo c("还缺 " . $need . " 个必要项", "r") . "，tsf build 会失败" . PHP_EOL;
    echo PHP_EOL . "修复思路：" . PHP_EOL;
    echo "  1. 装 PHP 8.5（ZTS），带 swoole，并配上 phpx" . PHP_EOL;
    echo "     → 见 docs/guide/00-quickstart.md「环境准备」" . PHP_EOL;
    echo "  2. 构建 typephp-src 拿到 tpc：" . PHP_EOL;
    echo "     cd \$HOME/typephp-src && cmake ... && make" . PHP_EOL;
    echo "  3. 用环境变量覆盖默认路径（不想装在默认位置时）：" . PHP_EOL;
    echo "     export TPC=/path/to/tpc.php" . PHP_EOL;
    echo "     export TSF_PHP=php85" . PHP_EOL;
    return 1;
}



/**
 * 验证套件清单。
 *
 * **只收录确实跑过、且能独立跑起来的**。bench/ 下有二十多个 run*.sh，其中不少是
 * 压测/专项（bot、cluster-bench、probe-*），需要外部条件或跑很久，塞进"一键回归"
 * 只会让人对结果失去信任——一个长期红的套件等于没有套件。
 */
/// 按「显示宽度」补齐：str_pad 按字节算，一个汉字 3 字节会被当成 3 列，
/// 输出到终端就错位了。
function padWidth(string $s, int $width): string
{
    $len = mb_strlen($s, "UTF-8");
    return $s . str_repeat(" ", max(0, $width - $len));
}

function verifySuites(): array
{
    return [
        // 对比脚本是 python3 写的：缺它时 run.sh 会判 FAIL 而不是 SKIP，
        // 于是"环境没装"被当成"代码有问题"——正是 needs 要拦掉的那种假红
        ["id" => "semantics", "desc" => "AOT 语言语义差分（45 用例）", "sh" => "tests/aot-semantics/run.sh", "needs" => ["python3"]],
        ["id" => "swoole", "desc" => "Swoole 契约（6 项）", "sh" => "tests/swoole-contract/run.sh"],
        ["id" => "settle", "desc" => "金币账本（91 项）", "sh" => "tests/settle-test/run.sh"],
        ["id" => "settle-crash", "desc" => "账本崩溃重放（14 项）", "sh" => "tests/settle-crash/run.sh"],
        ["id" => "fd", "desc" => "fd/内存守卫（10 项）", "sh" => "tests/fd-test/run.sh"],
        ["id" => "room", "desc" => "房间/成员/共享宿主（100 项）", "sh" => "tests/room-test/run.sh"],
        ["id" => "cluster", "desc" => "集群/房间归属（11 项）", "sh" => "demo/duel/run-cluster.sh"],
        ["id" => "cluster-chan", "desc" => "集群通道/握手（TCP 11 项 + UDS 2000 往返）", "sh" => "tests/cluster-test/run.sh"],
        // 需要 Redis；没有的话脚本自己打 SKIP 并返回 0（环境没装不该判红）
        ["id" => "registry", "desc" => "Redis 注册表+租约（38 项，无 Redis 则 SKIP）", "sh" => "tests/registry-test/run.sh"],
        ["id" => "handoff", "desc" => "状态交接（101 项：交接/闸门/重平衡/租约/撤销）", "sh" => "tests/handoff-test/run.sh"],
        ["id" => "checkpoint", "desc" => "事件日志检查点（23 项：截断/等价/坏点被拒）", "sh" => "tests/checkpoint-test/run.sh"],
        ["id" => "drain", "desc" => "进程 drain（8 项）", "sh" => "demo/duel/run-drain.sh"],
        ["id" => "rejoin", "desc" => "断线重连（6 项）", "sh" => "demo/duel/run-rejoin.sh"],
        ["id" => "script", "desc" => "脚本热更（加载/对象共享/越权/热更/异常）", "sh" => "tests/script-test/run.sh"],
        ["id" => "http", "desc" => "HTTP 接口（路由/中间件/鉴权/限流）", "sh" => "tests/http-test/run.sh"],
    ];
}

/**
 * 一键回归。
 *
 * 存在意义不是"省几条命令"，而是让「跑没跑过」这件事有唯一答案：
 * 之前验证散在 9 个目录里，各自的入口、前置条件、判定方式都不一样，
 * 新人接手时最贵的成本是"不知道有这些脚本"。
 */
function verifyRun(string $root, array $argv): int
{
    $suites = verifySuites();

    $only = "";
    $list = false;
    // argv[0] 是脚本路径、argv[1] 是子命令名，都不该参与过滤。
    // 不 slice 的话，裸 `tsf verify` 会把脚本路径当成 only 去匹配套件 id，
    // 结果一个套件都不跑、还报「通过 0 / 失败 0 / 跳过 0」——看着像"全绿"。
    foreach (array_slice($argv, 2) as $a) {
        if ($a === "--list") {
            $list = true;
        } elseif (strpos($a, "--only=") === 0) {
            $only = substr($a, 7);
        } elseif ($a !== "verify" && $a !== "" && $a[0] !== "-") {
            $only = $a;
        }
    }

    if ($list) {
        foreach ($suites as $s) {
            $mark = is_file($root . "/" . $s["sh"]) ? " " : "!";
            echo $mark . " " . padWidth($s["id"], 14) . $s["desc"] . PHP_EOL;
        }
        echo PHP_EOL . "（! 表示脚本不存在）" . PHP_EOL;
        return 0;
    }

    $pass = 0;
    $fail = 0;
    $skip = 0;
    $rows = [];

    foreach ($suites as $s) {
        if ($only !== "" && strpos($s["id"], $only) === false) {
            continue;
        }
        // 依赖外部工具链的套件：缺了就跳过，别让它把整套判成失败。
        // 一个因为环境没配而永远红的套件，会让人学会忽略整个 CI。
        if (isset($s["needs"])) {
            $lack = [];
            foreach ($s["needs"] as $tool) {
                if (findInPath($tool) === null) {
                    $lack[] = $tool;
                }
            }
            if ($lack !== []) {
                $rows[] = ["id" => $s["id"], "desc" => $s["desc"], "state" => "SKIP", "ms" => 0, "tail" => "缺 " . implode(",", $lack)];
                $skip++;
                fwrite(STDERR, "→ " . $s["id"] . " ... SKIP（缺 " . implode(",", $lack) . "）" . PHP_EOL);
                continue;
            }
        }

        $path = $root . "/" . $s["sh"];
        if (!is_file($path)) {
            // demo 是子模块：没跑 git submodule update --init 时这里必然缺
            $why = strpos($s["sh"], "demo/") === 0 ? "demo 子模块未初始化" : "脚本不存在";
            $rows[] = ["id" => $s["id"], "desc" => $s["desc"], "state" => "SKIP", "ms" => 0, "tail" => $why];
            $skip++;
            fwrite(STDERR, "→ " . $s["id"] . " ... SKIP（" . $why . "）" . PHP_EOL);
            continue;
        }

        fwrite(STDERR, "→ " . $s["id"] . " ... ");
        $t0 = microtime(true);
        $out = [];
        $rc = 0;
        exec("bash " . escapeshellarg($path) . " 2>&1", $out, $rc);
        $ms = (int) ((microtime(true) - $t0) * 1000);

        // 77 = 脚本主动跳过（端口被占、本机有冲突服务……）。
        // 和 needs 走同一条路：环境问题不该把整套判红，但必须在输出里留下痕迹，
        // 不能让"没跑"看起来像"跑过了"。
        if ($rc === 77) {
            $why = "";
            foreach (array_reverse($out) as $line) {
                if (strpos($line, "SKIP") === 0) {
                    $why = $line;
                    break;
                }
            }
            $rows[] = ["id" => $s["id"], "desc" => $s["desc"], "state" => "SKIP", "ms" => $ms, "tail" => $why];
            $skip++;
            fwrite(STDERR, "SKIP" . PHP_EOL);
            continue;
        }

        $tail = "";
        if ($rc !== 0) {
            $tail = implode(" | ", array_slice($out, -4));
        }
        $state = $rc === 0 ? "PASS" : "FAIL";
        if ($rc === 0) {
            $pass++;
        } else {
            $fail++;
        }
        fwrite(STDERR, $state . PHP_EOL);
        $rows[] = ["id" => $s["id"], "desc" => $s["desc"], "state" => $state, "ms" => $ms, "tail" => $tail];
    }

    echo PHP_EOL;
    echo padWidth("结果", 6) . padWidth("套件", 15) . padWidth("内容", 34) . "耗时" . PHP_EOL;
    echo str_repeat("-", 68) . PHP_EOL;
    foreach ($rows as $r) {
        $sec = number_format($r["ms"] / 1000, 1) . "s";
        echo padWidth($r["state"], 6) . padWidth($r["id"], 15) . padWidth($r["desc"], 34) . $sec . PHP_EOL;
        if ($r["tail"] !== "") {
            echo "      ↳ " . $r["tail"] . PHP_EOL;
        }
    }
    echo str_repeat("-", 68) . PHP_EOL;
    echo "通过 " . $pass . " / 失败 " . $fail . " / 跳过 " . $skip . PHP_EOL;

    return $fail === 0 ? 0 : 1;
}

function doBuild(string $projDir, string $tsfRoot, string $tpc, string $phpBin): int
{
    if (!is_dir($projDir)) {
        fail("工程目录不存在: " . $projDir);
    }
    try {
        $yml = genProjectYml($projDir, $tsfRoot);
    } catch (\RuntimeException $e) {
        fail($e->getMessage());
    }
    file_put_contents($projDir . "/project.yml", $yml);
    $cmd = $phpBin . " " . escapeshellarg($tpc) . " project.yml";
    $r = runCmdCapture($cmd, $projDir);
    if ($r["rc"] === 0) {
        return 0;
    }

    // 只有 **g++ 阶段** 的失败需要重试：并行编译（默认 4 job）会把 g++ 的
    // stderr 吞掉，只留一句 `Compilation failed for: .../main.cc` + Translator 堆栈，
    // 真正的错误（`error: 'server' is not captured`）看不到。
    //
    // 而 PHP→C++ 转换阶段的失败（`Fatal error: The variable $a is undefined ...`）
    // 本来就打得很清楚，重试只会把同样的错误打第二遍，白等一次编译。
    if (strpos($r["out"], "Compilation failed for:") === false) {
        return $r["rc"];
    }

    // 串行重试的代价很小：已成功的文件命中增量缓存（会输出 [cached]），
    // 只会真正编译出错的那几个。
    say("");
    say(c("  编译失败。", "y") . "并行模式吞掉了 g++ 的错误，改用串行模式重试以显示真实原因：");
    say(c("  （已成功的文件走增量缓存，只重编出错的）", "d"));
    say("");
    $cmd2 = $phpBin . " " . escapeshellarg($tpc) . " project.yml -j 1";
    return runCmd($cmd2, $projDir);
}

function findBinary(string $projDir): string
{
    $name = basename($projDir);
    $candidates = [
        $projDir . "/" . str_replace("-", "_", $name),
        $projDir . "/" . $name,
    ];
    foreach ($candidates as $c) {
        if (is_file($c) && is_executable($c)) {
            return $c;
        }
    }
    return "";
}

/** 生成的主程序模板 */
/** 从 tsf/tpl 读一个模板；缺文件时返回空串（让调用方暴露问题，而不是生成空文件） */
function tplFile(string $name): string
{
    $path = __DIR__ . "/../tpl/" . $name;
    $s = @file_get_contents($path);
    if (!is_string($s) || $s === "") {
        fwrite(STDERR, "缺少模板文件：" . $path . PHP_EOL);
        return "";
    }
    return $s;
}

/**
 * wasm 模块的 project.yml。
 *
 * wasm-package / wasm-world 从 `pkg/wasm/src/Iface.php` 读 —— 那是唯一来源。
 * 之前模板里写死字符串，一旦上游的 world 名变了，所有工程的 project.yml 都要手工改。
 */



/**
 * 生成登录服工程。
 *
 * 和游戏服的区别：**只有 HTTP，没有帧协议**。所以不生成 client.php、不生成
 * modules/（wasm 热更和登录无关），config 里也没有 protocol 段。
 */
function cmdNewLogin(string $name, string $cwd, string $tsfRoot): int
{
    // 和 case "new" 一样支持 "." （先 composer require 再 tsf new . --login）
    if ($name === "." || $name === "./") {
        $projDir = $cwd;
        if (file_exists($projDir . "/main.php") || file_exists($projDir . "/project.json")) {
            fail("当前目录已经是 tsf 工程（已有 main.php 或 project.json）: " . $projDir);
        }
    } else {
        $projDir = $cwd . "/" . $name;
        if (is_dir($projDir)) {
            fail("目录已存在: " . $projDir);
        }
    }
    ensureDir($projDir . "/config");
    ensureDir($projDir . "/var/log");

    $secret = bin2hex(random_bytes(16));

    $cfg = [
        "app" => ["name" => $name],
        "log" => ["level" => "info", "file" => $projDir . "/var/log/app.log"],
        "login" => [
            "host" => "0.0.0.0",
            "port" => 9101,
            "secret" => $secret,
            // token 有效期（秒）。网关侧不需要知道 ttl，它只验签和过期。
            "token_ttl" => 300,
            // 告诉客户端该连哪个网关（真实项目应该按大区/负载返回不同地址）
            "gateway" => "127.0.0.1:9001",
        ],
    ];
    file_put_contents(
        $projDir . "/config/tsf.json",
        json_encode($cfg, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"
    );

    $body = tplLogin();
    if ($body === "") {
        fail("找不到模板 tpl/login.main.php.txt");
    }
    file_put_contents($projDir . "/main.php", $body);

    // 登录服依赖 pkg/http（路由 + 统一响应）
    writeProjectJson($projDir, ["name" => $name, "packages" => ["http"]]);
    file_put_contents($projDir . "/project.yml", genProjectYml($projDir, $tsfRoot));

    ok("登录服已创建: " . $projDir);
    say("");
    say("下一步：");
    if ($name !== "." && $name !== "./") {
        say("  cd " . $name);
    }
    say("  tsf serve .                       # 编译并启动（默认 9101）");
    say("  curl -X POST -d 'name=alice' \\");
    say("    http://127.0.0.1:9101/login     # 拿 uid + token");
    say("");
    say("把 config/tsf.json 里的 secret 抄到游戏服的 server.auth.secret，");
    say("两边一致网关才会认这个 token。");
    return 0;
}

/** 登录服模板 */
function tplLogin(): string
{
    $f = __DIR__ . "/../tpl/login.main.php.txt";
    $s = @file_get_contents($f);
    return is_string($s) ? $s : "";
}

function tplMain(): string
{
    // 模板独立成文件（tsf/tpl/main.php.txt）：内容有一百多行、含多个顶层函数，
    // 塞进 heredoc 会让 bin/tsf 本身难读，也失去语法高亮。
    // 找不到模板时返回空串 —— 让调用方在写文件时暴露出来，而不是生成一个空 main.php。
    $path = __DIR__ . "/../tpl/main.php.txt";
    $s = @file_get_contents($path);
    if (!is_string($s) || $s === "") {
        fwrite(STDERR, "缺少模板文件：" . $path . PHP_EOL);
        return "";
    }
    return $s;
}

/** 生成的客户端模板；__TSF_ROOT__ 会被替换成框架根目录的绝对路径 */
function tplClient(): string
{
    $php = '<?php

// 最小客户端：用框架同一份帧实现编解码，验证端到端。
// 客户端只需要协议的"契约 + 头实现"三个文件（不需要传输层/Gateway）。
require_once "__TSF_ROOT__/src/Protocol/Contract/DecodedFrame.php";
require_once "__TSF_ROOT__/src/Protocol/Contract/FrameCodec.php";
require_once "__TSF_ROOT__/src/Protocol/Frame/HeaderFrame.php";

use TSF\Protocol\Frame\HeaderFrame;

$port = (int) ($argv[1] ?? 9001);
$token = (string) ($argv[2] ?? "tok-1001");

$sock = stream_socket_client("tcp://127.0.0.1:" . $port, $errno, $errstr, 3);
if ($sock === false) {
    fwrite(STDERR, "connect failed: " . $errstr . PHP_EOL);
    exit(1);
}

/**
 * 读一帧，返回 [msgId, body]；超时返回 null。
 * 缓冲区用 static 保留：一次读到两帧时，第二帧不会丢。
 */
function readFrame($sock, float $timeout = 3.0): ?array
{
    static $buf = "";
    $deadline = microtime(true) + $timeout;
    while (microtime(true) < $deadline) {
        $f = HeaderFrame::parse($buf);
        if ($f !== null) {
            $buf = substr($buf, $f->consumed);
            return [$f->msgId, $f->body];
        }
        $chunk = fread($sock, 65536);
        if ($chunk === false || $chunk === "") {
            if (feof($sock)) {
                return null;
            }
            usleep(1000);
            continue;
        }
        $buf .= $chunk;
    }
    return null;
}

// 1) 登录（默认配置要求鉴权，业务消息必须登录后才能发）
fwrite($sock, HeaderFrame::build(1, $token));          // 1 = MSG_LOGIN
$r = readFrame($sock);
if ($r === null || $r[0] !== 2) {                       // 2 = MSG_LOGIN_OK
    fwrite(STDERR, "login failed: " . var_export($r, true) . PHP_EOL);
    exit(1);
}
echo "login ok uid=" . $r[1] . PHP_EOL;

// 2) echo 往返
$payload = "hello-tsf-" . time();
fwrite($sock, HeaderFrame::build(1001, $payload));      // 1001 = MSG_ECHO_REQ
$r = readFrame($sock);
if ($r === null) {
    fwrite(STDERR, "timeout waiting response" . PHP_EOL);
    fclose($sock);
    exit(1);
}
echo "resp msgId=" . $r[0] . " body=" . $r[1] . PHP_EOL;
echo ($r[1] === $payload ? "OK: echo matched" : "FAIL: body mismatch") . PHP_EOL;
fclose($sock);
exit($r[1] === $payload ? 0 : 1);
';
    return $php;
}

// ---------------- 命令 ----------------

/**
 * 结构约束检查：把"约定"变成可执行的门禁，而不是只写在文档里。
 *
 * 三条规则（对应 README §3 与 §5.8）：
 *   1. 源码里不允许出现 `mixed` 类型声明 —— 用 `string|array|object` 等明确联合类型
 *   2. 命名空间必须与目录路径一致（PSR-4）：TSF\A\B 必须在 src/A/B.php
 *   3. ext/ 下不允许出现 TSF\* 命名空间的类 —— 扩展只提供原生原语
 */
/**
 * @param array<int, string> $problems
 */
function lintTree(string $base, string $nsPrefix, string $root, array &$problems, array &$hints): int
{
    if (!is_dir($base)) {
        return 0;
    }
    $checked = 0;
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($base));
    foreach ($it as $f) {
        if (!$f->isFile() || substr($f->getPathname(), -4) !== ".php") {
            continue;
        }
        $path = $f->getPathname();
        $rel = str_replace($base . "/", "", $path);
        $class = basename($rel, ".php");
        $expected = $nsPrefix . "\\" . str_replace("/", "\\", substr($rel, 0, -4));
        $code = file_get_contents($path);
        $checked++;

        // 规则 2：命名空间与路径一致
        if (preg_match('/^namespace\s+([^;]+);/m', $code, $m)) {
            $ns = trim($m[1]);
            if ($ns . "\\" . $class !== $expected) {
                $problems[] = str_replace($root . "/", "", $path)
                    . "  命名空间是 " . $ns . "，按路径应为 " . substr($expected, 0, -strlen($class) - 1);
            }
        } else {
            $problems[] = str_replace($root . "/", "", $path) . "  缺少 namespace 声明";
        }

        // 规则 1：不允许 mixed 类型声明（跳过注释行）
        $lines = explode("\n", $code);
        foreach ($lines as $i => $line) {
            $t = ltrim($line);
            if ($t === "" || $t[0] === "*" || strncmp($t, "//", 2) === 0 || $t[0] === "#") {
                continue;
            }
            // 去掉行尾注释再判断，避免注释里的示例被误报
            $codePart = $line;
            $posComment = strpos($codePart, "//");
            if ($posComment !== false) {
                $codePart = substr($codePart, 0, $posComment);
            }
            if (preg_match('/(?<![A-Za-z0-9_\\\\])mixed(?![A-Za-z0-9_])/', $codePart)) {
                $problems[] = str_replace($root . "/", "", $path) . ":" . ($i + 1)
                    . "  出现 mixed 类型声明 → " . trim($codePart);
            }

            // 规则 5（提示，不阻塞）：内置文件函数直接吃属性访问
            //
            // 踩过两次的坑：`filemtime($this->path)` 在 AOT 下会被编译成
            // "不传参"的调用，运行到那一行才报
            // `filemtime(): Argument #1 ($filename) not passed`，编译期无告警，
            // 报错信息也完全看不出是编译器的问题。先取局部变量即可。
            //
            // 之所以只是"提示"而不是"错误"：框架自身就有十几处这种写法且运行正常，
            // 说明触发条件比我理解的更窄。把不确定的东西做成阻塞会逼人写 --no-lint。
            if (preg_match('/\b(filemtime|filesize|file_exists|is_file|is_readable|is_dir|file_get_contents|file_put_contents|opcache_invalidate|unlink)\s*\(\s*\$this->[A-Za-z_][A-Za-z0-9_]*\s*[,)]/', $codePart, $m)) {
                $hints[] = str_replace($root . "/", "", $path) . ":" . ($i + 1)
                    . "  " . $m[1] . "() 直接吃属性访问 → AOT 下可能编译成不传参，建议先取局部变量";
            }
        }
    }
    return $checked;
}

function cmdLint(string $root): int
{
    $problems = [];
    $hints = [];
    $checked = 0;

    $pkgs = listPackages($root);

    // 核心
    $checked += lintTree($root . "/src", "TSF", $root, $problems, $hints);

    // 规则 4：核心不得引用可选包（依赖必须单向 src ← pkg）
    //
    // 这条规则的意义不是洁癖。一旦核心 use 了某个 pkg，那个「可选包」就变成事实上的
    // 必需品 —— 关掉它核心编不过。同时意味着核心接受了那个包的业务假设（房间、AOI、
    // 存档……）。可选性靠依赖方向保证，不靠文档承诺。
    $pkgNs = [];
    foreach ($pkgs as $name => $d) {
        $pkgNs[$name] = isset($d["ns"]) ? (string) $d["ns"] : "TSF\\" . ucfirst($name);
    }
    $it4 = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . "/src"));
    foreach ($it4 as $f) {
        if (!$f->isFile() || substr($f->getPathname(), -4) !== ".php") {
            continue;
        }
        $code = (string) file_get_contents($f->getPathname());
        foreach ($pkgNs as $pname => $bad) {
            if (preg_match('/^use\s+' . preg_quote($bad, "/") . '\\\\/m', $code)) {
                $problems[] = str_replace($root . "/", "", $f->getPathname())
                    . "  核心引用了可选包 " . $pname . " → 依赖必须单向（src 不得 use pkg）";
            }
        }
    }

    // 可选功能包：每个包自己声明根命名空间（pkg.json 的 ns 字段）
    foreach ($pkgs as $name => $d) {
        $ns = isset($d["ns"]) ? (string) $d["ns"] : "TSF\\" . ucfirst($name);
        $checked += lintTree($root . "/pkg/" . $name . "/src", $ns, $root, $problems, $hints);
    }

    // 规则 3：ext/ 不出现 TSF 命名空间
    if (is_dir($root . "/ext")) {
        $it2 = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . "/ext"));
        foreach ($it2 as $f) {
            if (!$f->isFile() || substr($f->getPathname(), -4) !== ".php") {
                continue;
            }
            $code = file_get_contents($f->getPathname());
            if (preg_match('/^namespace\s+TSF\\\\/m', $code)) {
                $problems[] = str_replace($root . "/", "", $f->getPathname())
                    . "  ext/ 下不允许 TSF 命名空间的类（适配类应放 src/）";
            }
        }
    }

    if ($problems === []) {
        ok("结构检查通过：" . $checked . " 个源文件（核心 + " . count($pkgs) . " 个包），"
            . "无 mixed 类型、命名空间与目录一致、核心不依赖可选包");
        // 提示不阻塞：它们指向"AOT 下可能出问题"的写法，但触发条件尚未完全摸清，
        // 做成阻塞会逼人跳过 lint。最多列 8 条，避免刷屏。
        if ($hints !== []) {
            say("");
            say("另有 " . count($hints) . " 条提示（不阻塞，供排查 AOT 怪问题时参考）：");
            $shown = 0;
            foreach ($hints as $h) {
                if ($shown >= 8) {
                    say("  · …… 还有 " . (count($hints) - 8) . " 条");
                    break;
                }
                say("  · " . $h);
                $shown++;
            }
        }
        return 0;
    }

    say("结构检查发现 " . count($problems) . " 处问题：");
    foreach ($problems as $p) {
        say("  ✗ " . $p);
    }
    return 1;
}

/**
 * watch 的轮询间隔（ms）。
 *
 * 200 ms 是"感知上即时"和"别把 CPU 烧在扫描上"的折中。实测全量编译 1.0~1.3 s，
 * 所以轮询间隔根本不是瓶颈——**准不准才是**。
 */
const WATCH_POLL_MS = 200;

/**
 * 监听集合 = `project.yml` 的 sources 列表 + project.json。
 *
 * 为什么不自己写一份"该监听 src/ 和 main.php"：那是**构建输入的副本**，
 * 加了 `gen/`（配置/协议生成物）或新包之后就会漂。直接从 project.yml 读，
 * 永远不会漏——因为编译用的就是这份列表。
 */
function watchSourcePaths(string $projDir): array
{
    $out = [];
    $yml = @file_get_contents($projDir . "/project.yml");
    if ($yml !== false) {
        foreach (explode("\n", $yml) as $line) {
            $t = trim($line);
            if (strncmp($t, "- ", 2) === 0) {
                $p = trim(substr($t, 2));
                if ($p !== "") {
                    $out[] = $p;
                }
            }
        }
    }
    // project.json 决定用哪些包：改它要重编（project.yml 会跟着变，但自己也要在监听范围里）
    $out[] = $projDir . "/project.json";
    return $out;
}

/** @return string[] 递归收集 *.php */
function scanPhpFiles(string $dir): array
{
    $out = [];
    $items = @scandir($dir);
    if ($items === false) {
        return $out;
    }
    foreach ($items as $name) {
        if ($name === "." || $name === "..") {
            continue;
        }
        $p = $dir . "/" . $name;
        if (is_dir($p)) {
            foreach (scanPhpFiles($p) as $f) {
                $out[] = $f;
            }
            continue;
        }
        if (substr($name, -4) === ".php") {
            $out[] = $p;
        }
    }
    return $out;
}

/**
 * 按**内容**算指纹，不看 mtime。
 *
 * `filemtime()` 只到秒：一秒内保存两次、或者改一个等长字符（`1` → `2`），
 * mtime+size 都察觉不到。这个坑 T5-02（服务发现）和 T6-02（配置热更）各踩过一次，
 * 这次直接按内容来。
 *
 * 代价是每轮要读一遍所有源文件。实测约 200 个文件 / 1~2 MB，一轮十几毫秒——
 * 在 200 ms 的轮询间隔下是可接受的，而"漏掉改动"的代价是开发者对着没生效的代码发呆。
 *
 * @return array{0: int, 1: int} [指纹, 文件数]
 */
function watchFingerprint(array $paths): array
{
    $h = 0;
    $n = 0;
    foreach ($paths as $p) {
        if (is_file($p)) {
            $c = @file_get_contents($p);
            $h = crc32($h . "|" . $p . "|" . crc32($c === false ? "" : $c));
            $n++;
            continue;
        }
        if (!is_dir($p)) {
            continue;
        }
        foreach (scanPhpFiles($p) as $f) {
            $c = @file_get_contents($f);
            $h = crc32($h . "|" . $f . "|" . crc32($c === false ? "" : $c));
            $n++;
        }
    }
    return [$h, $n];
}

/** 两段 hrtime 之间的毫秒数 */
function msOf(int $from, int $to): int
{
    return (int) round((float) ($to - $from) / 1000000.0);
}

/** 启动产物，返回进程句柄（同时记到 $GLOBALS，供信号处理器收尸） */
function startChild(string $projDir)
{
    $binPath = findBinary($projDir);
    if ($binPath === "") {
        fail("编译成功但找不到可执行文件");
    }
    $desc = [0 => STDIN, 1 => STDOUT, 2 => STDERR];
    $h = proc_open(escapeshellarg($binPath), $desc, $pipes, $projDir);
    if (!is_resource($h)) {
        fail("启动失败：" . $binPath);
    }
    $GLOBALS["tsf_watch_child"] = $h;
    return $h;
}

/**
 * 先 SIGTERM 再兜底 SIGKILL。
 *
 * 直接 SIGKILL 会跳过服务自己的 `onStop`（日志没刷、注册表没注销、快照没落盘）。
 * 开发期也要给优雅退出留 2 秒——不然调试"退出逻辑对不对"时永远测不出来。
 */
function stopChild($child)
{
    if (!is_resource($child)) {
        return null;
    }
    @proc_terminate($child, 15);
    $deadline = microtime(true) + 2.0;
    while (microtime(true) < $deadline) {
        $st = proc_get_status($child);
        if (!is_array($st) || !isset($st["running"]) || !$st["running"]) {
            break;
        }
        usleep(10000);
    }
    $st = proc_get_status($child);
    if (is_array($st) && isset($st["running"]) && $st["running"]) {
        @proc_terminate($child, 9);
    }
    @proc_close($child);
    $GLOBALS["tsf_watch_child"] = null;
    return null;
}

switch ($cmd) {
    case "version":
        say("TSF " . TSF_VERSION . "  (tpc: " . $tpc . ")");
        break;

    case "lint":
        exit(cmdLint($tsfRoot));
        break;

    case "new":
        // name = 第一个不以 -- 开头的参数。
        //
        // 不能直接拿 $arg（= $argvv[2]）：`tsf new --login` 会把 flag 当成名字，
        // 结果是生成一个叫 "--login" 的目录（实测过）。
        $name = "";
        $argc = count($argvv);
        for ($i = 2; $i < $argc; $i++) {
            if (strncmp($argvv[$i], "--", 2) !== 0) {
                $name = $argvv[$i];
                break;
            }
        }
        if ($name === "") {
            fail("用法: tsf new <name> [--login]    （名字写 . 表示在当前目录生成）");
        }
        $isLogin = in_array("--login", $argvv, true);

        // "." / "./"：在当前目录生成。
        //
        // 这是最重要的场景：先 composer require（目录里已经有 composer.json / vendor / lock），
        // 再 tsf new . —— 用 is_dir 判断"已存在"会把当前目录永远判成冲突。
        // 改成检查"关键产物是否已存在"，只拦真正的重复生成。
        $inPlace = ($name === "." || $name === "./");

        if ($isLogin) {
            exit(cmdNewLogin($inPlace ? "." : $name, getcwd(), $tsfRoot));
        }

        if ($inPlace) {
            $projDir = getcwd();
            if (file_exists($projDir . "/main.php") || file_exists($projDir . "/project.json")) {
                fail("当前目录已经是 tsf 工程（已有 main.php 或 project.json）: " . $projDir);
            }
        } else {
            $projDir = getcwd() . "/" . $name;
            if (is_dir($projDir)) {
                fail("目录已存在: " . $projDir);
            }
        }
        ensureDir($projDir . "/config");
        ensureDir($projDir . "/src");
        ensureDir($projDir . "/var/log");


        // 构建清单：声明这个工程要用哪些可选功能包（默认一个都不用）
        writeProjectJson($projDir, ["name" => $arg, "packages" => []]);

        $cfg = [
            "app" => ["name" => $arg],
            "log" => [
                "level" => "info",
                "file" => $projDir . "/var/log/app.log",
            ],
            // 协议：分帧层 + 消息体层，两层独立可换
            "protocol" => [
                // frame:   native（C++，推荐）| header（纯 PHP，排障用）
                "frame" => "native",
                // payload: raw（透传）| json | msgpack | protobuf | registry
                "payload" => "raw",
            ],
            "server" => [
                "host" => "0.0.0.0",
                "port" => 9001,
                // tcp | ws（WebSocket；payload 仍是同一套二进制帧）
                "transport" => "tcp",
                "worker_num" => 1,
                "max_conn" => 10000,
                "nodelay" => true,
                // 心跳：服务端超过这么多秒没收到任何帧就断开
                "heartbeat_sec" => 30,
                // 限流：每秒补充 rate_per_sec 个令牌，桶容量 rate_burst
                "rate_per_sec" => 50,
                "rate_burst" => 100,
                "auth" => [
                    // require=false 仅用于压测/内网；生产必须为 true
                    "require" => true,
                    "secret" => "dev-secret-change-me",
                    "tokens" => [
                        "tok-1001" => 1001,
                        "tok-1002" => 1002,
                    ],
                ],
            ],
        ];
        file_put_contents(
            $projDir . "/config/tsf.json",
            json_encode($cfg, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"
        );

        file_put_contents($projDir . "/main.php", tplMain());

        $client = str_replace("__TSF_ROOT__", $tsfRoot, tplClient());
        file_put_contents($projDir . "/client.php", $client);

        file_put_contents($projDir . "/project.yml", genProjectYml($projDir, $tsfRoot));

        ok("工程已创建: " . $projDir);
        say("");
        say("下一步：");
        if (!$inPlace) {
            say("  cd " . $name);
        }
        say("  tsf serve .            # 编译并启动");
        say("  php85 client.php       # 另开终端验证 echo");
        break;

    case "list":
        $all = listPackages($tsfRoot);
        $explicit = [];
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir !== false) {
            $proj = readProjectJson($projDir);
            foreach ($proj["packages"] as $p) {
                $explicit[(string) $p] = true;
            }
        }
        $resolved = [];
        if ($explicit !== []) {
            try {
                foreach (resolvePackages(array_keys($explicit), $all) as $n) {
                    $resolved[$n] = true;
                }
            } catch (\RuntimeException $e) {
                say("  ! " . $e->getMessage());
            }
        }

        say("可选功能包（tsf/pkg/）：");
        if ($all === []) {
            say("  （无）");
            break;
        }
        foreach ($all as $name => $d) {
            if (isset($explicit[$name])) {
                $mark = "[x]";
            } elseif (isset($resolved[$name])) {
                $mark = "[+]"; // 依赖被带上，不是显式启用
            } else {
                $mark = "[ ]";
            }
            $desc = isset($d["desc"]) ? (string) $d["desc"] : "";
            $req = "";
            if (isset($d["requires"]) && is_array($d["requires"]) && $d["requires"] !== []) {
                $req = "  依赖: " . implode(",", $d["requires"]);
            }
            say("  " . $mark . " " . str_pad($name, 10) . $desc . $req);
        }
        say("");
        say("  [x] 显式启用   [+] 依赖带入   [ ] 未启用");
        break;

    case "add":
    case "remove":
        if ($arg === "") {
            fail("用法: tsf " . $cmd . " <package>");
        }
        $projDir = getcwd();
        // 必须有 project.json 才动手。早先直接按 cwd 写，在工程父目录执行时
        // 会新建一个空的 project.json 并"成功"提示已启用 —— 而真正的工程
        // 配置一点没变，下次 build 依然没编进那个包，排查时完全想不到是这一步。
        if (!is_file($projDir . "/project.json")) {
            fail(
                "当前目录没有 project.json，不能在" . "这里改包集合。" . PHP_EOL
                . "  当前目录: " . $projDir . PHP_EOL
                . "  请 cd 到工程目录再执行（含 main.php 与 project.json 的那一层）"
            );
        }
        $all = listPackages($tsfRoot);
        if (!isset($all[$arg])) {
            fail("没有这个包: " . $arg . "（用 tsf list 查看可用包）");
        }
        $proj = readProjectJson($projDir);
        $pkgs = [];
        foreach ($proj["packages"] as $p) {
            $pkgs[] = (string) $p;
        }
        if ($cmd === "add") {
            // 只记显式启用的包；依赖在构建时由 resolvePackages 展开
            if (!in_array($arg, $pkgs, true)) {
                $pkgs[] = $arg;
            }
        } else {
            $kept = [];
            foreach ($pkgs as $p) {
                if ($p !== $arg) {
                    $kept[] = $p;
                }
            }
            $pkgs = $kept;
        }
        $proj["packages"] = $pkgs;
        writeProjectJson($projDir, $proj);
        ok(($cmd === "add" ? "已启用 " : "已移除 ") . $arg . "；当前显式启用: [" . implode(", ", $pkgs) . "]");
        try {
            $res = resolvePackages($pkgs, $all);
            say("构建时的实际包集合: [" . implode(", ", $res) . "]");
        } catch (\RuntimeException $e) {
            say("  ! " . $e->getMessage());
        }
        say("重新编译后生效: tsf build .");
        break;

    case "config":
        // 配置表工具链只在开发机跑（解释执行），不进 AOT 产物。
        // 所以它可以用 ZipArchive/SimpleXML 读 Excel，而运行期只用 tsf/src/Config/Reader
        $toolDir = $tsfRoot . "/tools/config";
        require_once $toolDir . "/Bin.php";
        require_once $toolDir . "/Field.php";
        require_once $toolDir . "/Xlsx.php";
        require_once $toolDir . "/Exporter.php";

        $sub = $arg;
        $dirArg = isset($argvv[3]) ? (string) $argvv[3] : ".";
        if ($sub !== "build" && $sub !== "check") {
            say("用法: tsf config build|check [工程目录]");
            say("  build  Excel → gen/Config/*.php + build/config/*.bin");
            say("  check  只校验，不写产物");
            exit(2);
        }
        $projDir = realpath($dirArg);
        if ($projDir === false) {
            fail("目录不存在: " . $dirArg);
        }
        $exporter = new \TSF\Tool\Config\Exporter($projDir);
        $rc = $exporter->run($sub === "build");
        if ($rc === 0 && $sub === "build") {
            ok("配置表已导出到 " . $projDir . "/build/config");
        }
        exit($rc);

    case "proto":
        // 协议生成：只在开发机跑，产物是 gen/Proto/*.php（会被编进二进制）
        $toolDir = $tsfRoot . "/tools/proto";
        require_once $toolDir . "/Parser.php";
        require_once $toolDir . "/Generator.php";

        $sub = $arg;
        $dirArg = isset($argvv[3]) ? (string) $argvv[3] : ".";
        if ($sub !== "build") {
            say("用法: tsf proto build [工程目录]");
            say("  读 <工程>/proto/*.proto（proto3 子集），生成 <工程>/gen/Proto/*.php");
            exit(2);
        }
        $projDir = realpath($dirArg);
        if ($projDir === false) {
            fail("目录不存在: " . $dirArg);
        }
        $files = glob($projDir . "/proto/*.proto");
        if ($files === false || $files === []) {
            fail("没有 .proto 文件：" . $projDir . "/proto/");
        }
        sort($files);

        $messages = [];
        $enums = [];
        $errors = [];
        foreach ($files as $file) {
            $src = (string) file_get_contents($file);
            $p = new \TSF\Tool\Proto\Parser($file);
            $r = $p->parse($src);
            foreach ($r["errors"] as $e) {
                $errors[] = $e;
            }
            foreach ($r["messages"] as $m) {
                $messages[] = $m;
            }
            foreach ($r["enums"] as $e) {
                $enums[] = $e;
            }
        }
        // 注意：这里**不能**因为解析出错就退出——语义校验还要跑（未知类型、协议号冲突…），
        // 否则用户得改一轮跑一轮。合并见下面
        $gen = new \TSF\Tool\Proto\Generator([
            "messages" => $messages,
            "enums" => $enums,
            "errors" => [],
        ]);
        // 解析出错也要往下跑语义校验：否则用户得先修语法、再跑一次才看到类型错误，
        // 改一轮跑一轮。这里把两阶段的问题合并成一张清单
        $gen->validate();
        $all = $errors;
        foreach ($gen->errors() as $e) {
            $all[] = $e;
        }
        if ($all !== []) {
            say("  ✗ 发现 " . count($all) . " 处问题，未生成任何文件：");
            foreach ($all as $e) {
                say("    " . $e);
            }
            exit(1);
        }

        $code = $gen->generate();

        $outDir = $projDir . "/gen/Proto";
        if (!is_dir($outDir) && !mkdir($outDir, 0777, true) && !is_dir($outDir)) {
            fail("建不了目录 " . $outDir);
        }
        $bytes = 0;
        foreach ($code as $name => $content) {
            file_put_contents($outDir . "/" . $name, $content);
            $bytes += strlen($content);
        }
        ok("生成 " . count($code) . " 个文件（" . count($messages) . " 个消息 / "
            . count($enums) . " 个枚举，" . round($bytes / 1024) . " KB）→ gen/Proto/");
        foreach ($messages as $m) {
            say("      " . $m["name"] . "  id=" . $m["id"] . "  字段 " . count($m["fields"]));
        }
        exit(0);

    case "build":
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }
        $code = doBuild($projDir, $tsfRoot, $tpc, $phpBin);
        if ($code !== 0) {
            fail("编译失败（exit " . $code . "）");
        }
        $binPath = findBinary($projDir);
        if ($binPath === "") {
            fail("编译成功但找不到可执行文件");
        }
        ok("产物: " . $binPath . "  (" . round(filesize($binPath) / 1024) . " KB)");
        break;

    case "migrate":
        // 部署步骤：跑一次就退出。**不要**把它塞进 workerStart——
        // 多 worker 会同时 CREATE TABLE，靠记录表只能挡"重复执行"，挡不住并发建表。
        // 生产上可以直接用产物：`./duel migrate`（本项目里就是 tsf migrate 干的事）
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }
        // 守卫：没有 migrations/ 的工程不该走这条路。更重要的是——产物里必须有
        // `migrate` 分支，否则 `./bin migrate` 会被当成"没带参数"直接起服务，
        // 部署脚本就挂在那里等一个永远不返回的迁移
        if (!is_dir($projDir . "/migrations")) {
            fail("这个工程没有 migrations/ 目录，不需要迁移");
        }
        $code = doBuild($projDir, $tsfRoot, $tpc, $phpBin);
        if ($code !== 0) {
            fail("编译失败（exit " . $code . "）");
        }
        $binPath = findBinary($projDir);
        if ($binPath === "") {
            fail("编译成功但找不到可执行文件");
        }
        ok("执行 " . basename($binPath) . " migrate");
        $rc = runCmd(escapeshellarg($binPath) . " migrate", $projDir);
        exit($rc);
        break;

    case "migrate-status":
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }
        if (!is_dir($projDir . "/migrations")) {
            fail("这个工程没有 migrations/ 目录");
        }
        $binPath = findBinary($projDir);
        if ($binPath === "") {
            fail("还没编译过：先跑 tsf build");
        }
        $rc = runCmd(escapeshellarg($binPath) . " migrate-status", $projDir);
        exit($rc);
        break;

    case "verify":
        $root = dirname(__DIR__, 2);
        exit(verifyRun($root, $argv));

    case "mem":
        exit(cmdMem($arg));

    case "doctor":
        exit(doctor($tsfRoot, $tpc, $phpBin));

    case "serve":
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }
        $code = doBuild($projDir, $tsfRoot, $tpc, $phpBin);
        if ($code !== 0) {
            fail("编译失败（exit " . $code . "）");
        }
        $binPath = findBinary($projDir);
        if ($binPath === "") {
            fail("找不到可执行文件");
        }
        ok("启动 " . basename($binPath) . "（Ctrl+C 结束）");
        runCmd(escapeshellarg($binPath), $projDir);
        break;

    case "watch":
        $projDir = $arg === "" ? getcwd() : realpath($arg);
        if ($projDir === false) {
            fail("目录不存在: " . $arg);
        }

        say(c("首次编译…", "b"));
        if (doBuild($projDir, $tsfRoot, $tpc, $phpBin) !== 0) {
            fail("首次编译失败，先修好再 watch（否则后面每改一次都失败）");
        }

        // 监听集合直接**从 project.yml 读**：那就是构建输入本身。
        // 自己另写一份"该监听哪些目录"一定会漂——加了 gen/ 或新包，watch 不知道
        $paths = watchSourcePaths($projDir);
        $child = startChild($projDir);
        $last = watchFingerprint($paths);
        ok("watch 就绪：" . $last[1] . " 个文件，轮询 " . WATCH_POLL_MS . "ms，Ctrl+C 退出");
        say(c("  监听：" . implode(" ", $paths), "d"));

        // Ctrl+C 要顺手把子进程收掉，否则留一个孤儿进程占着端口，
        // 下次 watch 会莫名其妙启动失败
        if (function_exists("pcntl_async_signals")) {
            pcntl_async_signals(true);
            $bye = function (): void {
                $c = $GLOBALS["tsf_watch_child"] ?? null;
                if (is_resource($c)) {
                    @proc_terminate($c, 15);
                }
                say("");
                say("watch 退出");
                exit(0);
            };
            pcntl_signal(SIGINT, $bye);
            pcntl_signal(SIGTERM, $bye);
        }

        while (true) {
            usleep(WATCH_POLL_MS * 1000);

            // 产物自己退出了（崩溃 / 正常结束）：报一次，别死循环重启。
            // 自动重启一个一启动就崩的程序只会刷屏，还掩盖真正的错误
            if (is_resource($child)) {
                $st = proc_get_status($child);
                if (is_array($st) && isset($st["running"]) && !$st["running"]) {
                    say(c("[watch] 产物已退出（exit " . (int) $st["exitcode"] . "），等待改动…", "y"));
                    @proc_close($child);
                    $child = null;
                    $GLOBALS["tsf_watch_child"] = null;
                }
            }

            $now = watchFingerprint($paths);
            if ($now[0] === $last[0]) {
                continue;
            }
            // 防抖：编辑器保存往往连着改几个文件（.php + 备份），
            // 立刻编的话会编到一半的状态，还会连编两次。
            // 120 ms 是"够等到第二次写"和"别白等"的折中
            usleep(120000);
            $paths = watchSourcePaths($projDir);
            $now = watchFingerprint($paths);
            $last = $now[0];

            $t0 = hrtime(true);
            $child = stopChild($child);
            $tStop = hrtime(true);
            say(c("[watch] 变更 " . $now[1] . " 个文件，重新编译…", "b"));
            $code = doBuild($projDir, $tsfRoot, $tpc, $phpBin);
            $tBuild = hrtime(true);
            if ($code !== 0) {
                // 编译失败**不重启**：旧进程已经停了，但与其带着旧二进制跑
                // （让人误以为改动生效了），不如让它停着，错误就在上面
                warn("编译失败，已停止；改好会自动重试");
                continue;
            }
            $child = startChild($projDir);
            $ms = (int) round((float) (hrtime(true) - $t0) / 1000000.0);
            ok("已重启（总计 " . $ms . " ms：停 " . msOf($t0, $tStop)
                . " + 编译 " . msOf($tStop, $tBuild)
                . " + 启动 " . msOf($tBuild, hrtime(true)) . "）");
        }
        break;

    default:
        say("TSF " . TSF_VERSION);
        say("");
        say("用法:");
        say("  tsf new <name>      新建工程");
        say("  tsf build [dir]     编译");
        say("  tsf migrate [dir]   跑数据库迁移（部署时执行一次，跑完退出）");
        say("  tsf migrate-status  只看迁移状态，不写库");
        say("  tsf serve [dir]     编译并启动");
        say("  tsf watch [dir]     开发模式（改动自动重编重启）");
        say("  tsf lint            结构检查（禁 mixed、命名空间一致、核心不依赖 pkg）");
        say("  tsf list            列出可选功能包（pkg/）及当前工程启用了哪些");
        say("  tsf add <pkg>       启用功能包（连带启用其依赖）");
        say("  tsf remove <pkg>    移除功能包");
        say("  tsf version         版本");
        say("");
        say("环境变量: TPC=<tpc.php 路径>  TSF_PHP=<php 可执行文件>");
        break;
}
